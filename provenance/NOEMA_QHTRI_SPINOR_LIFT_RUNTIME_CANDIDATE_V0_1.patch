+def spinor_sheet_from_turns(turns: np.ndarray) -> np.ndarray:
+    arr = np.asarray(turns)
+    if arr.shape != (N_OSCILLATORS,) or arr.dtype.kind not in "iu":
+        raise SurfaceStateIntegrityError("spinor turns must be exactly 36 integers")
+    return np.where(np.mod(arr, 2) == 0, 1, -1).astype(np.int8)
