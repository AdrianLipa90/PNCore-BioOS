+def _spinor_projective_phase(value: np.ndarray) -> np.ndarray:
+    arr = np.asarray(value, dtype=np.float64).reshape(-1)
+    if arr.shape != (N_OSCILLATORS,) or not np.all(np.isfinite(arr)):
+        raise SurfaceStateIntegrityError("spinor projective phase must be exactly 36 finite values")
+    return np.mod(arr, _SPINOR_TAU)
