+    epoch = json.loads(epoch_path.read_text(encoding="utf-8"))
+    if epoch.get("schema") != SPINOR_EPOCH_SCHEMA:
+        raise SurfaceStateIntegrityError("spinor epoch schema mismatch")
+    body = {key: value for key, value in epoch.items() if key != "spinor_epoch_id"}
+    if epoch.get("spinor_epoch_id") != sha256(_spinor_canonical_json(body)).hexdigest():
