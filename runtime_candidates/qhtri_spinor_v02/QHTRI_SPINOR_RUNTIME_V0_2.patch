+_SPINOR_TAU = 2.0 * np.pi
+_SPINOR_TURNS_FILE = "spinor_turns.i64"
+_SPINOR_TICK_FILE = "spinor_tick.u64"
+_SPINOR_EPOCH_FILE = "spinor_lift_epoch.json"
+
+
+def _spinor_atomic_bytes(path: Path, payload: bytes) -> None:
+    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    try:
+        with tmp.open("xb") as handle:
+            handle.write(payload)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(tmp, path)
+        dir_fd = os.open(path.parent, os.O_RDONLY)
+        try:
+            os.fsync(dir_fd)
+        finally:
+            os.close(dir_fd)
+    finally:
+        if tmp.exists():
+            tmp.unlink()
+
+
+def _spinor_canonical_json(value: Mapping[str, Any]) -> bytes:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode("utf-8")
+
+
+def _spinor_phase_sha(phi: np.ndarray) -> str:
+    arr = np.asarray(phi, dtype="<f8").reshape(N_OSCILLATORS)
+    return sha256(arr.tobytes(order="C")).hexdigest()
+
+
+def _spinor_sheet(turns: np.ndarray) -> np.ndarray:
+    arr = np.asarray(turns, dtype=np.int64).reshape(N_OSCILLATORS)
+    return np.where(np.mod(arr, 2) == 0, 1, -1).astype(np.int8)
+
+
+def _spinor_advance_exact(projected_before: np.ndarray, turns_before: np.ndarray, increment: np.ndarray) -> np.ndarray:
+    phase = np.mod(np.asarray(projected_before, dtype=np.float64), _SPINOR_TAU)
+    turns = np.asarray(turns_before, dtype=np.int64).reshape(N_OSCILLATORS)
+    delta = np.asarray(increment, dtype=np.float64).reshape(N_OSCILLATORS)
+    if not np.all(np.isfinite(delta)):
+        raise SurfaceStateIntegrityError("spinor exact increment is non-finite")
+    return turns + np.floor((phase + delta) / _SPINOR_TAU).astype(np.int64)
+
+
+def _spinor_advance_predicted(
+    projected_before: np.ndarray,
+    turns_before: np.ndarray,
+    predicted_increment: np.ndarray,
+    projected_after: np.ndarray,
+    *,
+    ambiguity_tolerance: float,
+) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    before = np.mod(np.asarray(projected_before, dtype=np.float64), _SPINOR_TAU)
+    after = np.mod(np.asarray(projected_after, dtype=np.float64), _SPINOR_TAU)
+    turns = np.asarray(turns_before, dtype=np.int64).reshape(N_OSCILLATORS)
+    increment = np.asarray(predicted_increment, dtype=np.float64).reshape(N_OSCILLATORS)
+    predicted_lift = before + _SPINOR_TAU * turns.astype(np.float64) + increment
+    turns_after = np.rint((predicted_lift - after) / _SPINOR_TAU).astype(np.int64)
+    selected_lift = after + _SPINOR_TAU * turns_after.astype(np.float64)
+    residual = predicted_lift - selected_lift
+    margin = np.pi - np.abs(residual)
+    if np.any(~np.isfinite(margin)) or np.any(margin <= ambiguity_tolerance):
+        idx = int(np.nanargmin(margin)) if np.any(np.isfinite(margin)) else -1
+        raise SurfaceStateIntegrityError(f"spinor lift ambiguity at oscillator {idx}")
+    return turns_after, residual, margin
+
