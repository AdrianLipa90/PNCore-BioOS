+class QhtriSpinorLineage:
+    """Tick-bound covering-space sidecar for the live QHTRI surface."""
+
+    def __init__(self, root: Path, *, ambiguity_tolerance: float = 1e-9) -> None:
+        self.root = Path(root)
+        self.ambiguity_tolerance = float(ambiguity_tolerance)
+        if not np.isfinite(self.ambiguity_tolerance) or not 0.0 <= self.ambiguity_tolerance < np.pi:
+            raise ValueError("ambiguity_tolerance must lie in [0, pi)")
+        self.turns_path = self.root / _SPINOR_TURNS_FILE
+        self.tick_path = self.root / _SPINOR_TICK_FILE
+        self.epoch_path = self.root / _SPINOR_EPOCH_FILE
+
+    def _presence(self) -> tuple[bool, bool, bool]:
+        return (self.turns_path.exists(), self.tick_path.exists(), self.epoch_path.exists())
+
+    def initialize_epoch(self, surface: Mapping[str, np.memmap], *, activation_ref: str) -> dict[str, Any]:
+        present = self._presence()
+        if any(present):
+            if not all(present):
+                raise SurfaceStateIntegrityError("partial spinor lineage state exists")
+            raise SurfaceStateIntegrityError("spinor lineage epoch already exists")
+        tick = int(np.asarray(surface["tick"], dtype=np.uint64)[0])
+        phi = np.asarray(surface["phi"], dtype=np.float64).copy()
+        turns = np.zeros(N_OSCILLATORS, dtype="<i8")
+        tick_arr = np.asarray([tick], dtype="<u8")
+        body = {
+            "schema": "NOEMA-QHTRI-SPINOR-LIFT-EPOCH/0.2",
+            "activation_tick": tick,
+            "activation_phase_sha256": _spinor_phase_sha(phi),
+            "activation_ref": str(activation_ref).strip(),
+            "turns_dtype": "<i8",
+            "turns_count": N_OSCILLATORS,
+            "tick_dtype": "<u8",
+        }
+        if not body["activation_ref"]:
+            raise ValueError("activation_ref is required")
+        epoch = {**body, "epoch_sha256": sha256(_spinor_canonical_json(body)).hexdigest()}
+        _spinor_atomic_bytes(self.turns_path, turns.tobytes(order="C"))
+        _spinor_atomic_bytes(self.tick_path, tick_arr.tobytes(order="C"))
+        _spinor_atomic_bytes(self.epoch_path, _spinor_canonical_json(epoch))
+        return epoch
+
+    def _validate_epoch(self) -> dict[str, Any]:
+        present = self._presence()
+        if not all(present):
+            if any(present):
+                raise SurfaceStateIntegrityError("partial spinor lineage state exists")
+            raise SurfaceStateIntegrityError("spinor lineage state is absent")
+        if self.turns_path.stat().st_size != N_OSCILLATORS * 8 or self.tick_path.stat().st_size != 8:
+            raise SurfaceStateIntegrityError("spinor lineage sidecar size mismatch")
+        try:
+            epoch = json.loads(self.epoch_path.read_text("utf-8"))
+        except (OSError, json.JSONDecodeError) as exc:
+            raise SurfaceStateIntegrityError("spinor lineage epoch is unreadable") from exc
+        if epoch.get("schema") != "NOEMA-QHTRI-SPINOR-LIFT-EPOCH/0.2":
+            raise SurfaceStateIntegrityError("spinor lineage epoch schema mismatch")
+        seal = epoch.get("epoch_sha256")
+        body = {k: v for k, v in epoch.items() if k != "epoch_sha256"}
+        if seal != sha256(_spinor_canonical_json(body)).hexdigest():
+            raise SurfaceStateIntegrityError("spinor lineage epoch seal mismatch")
+        return epoch
+
+    def begin(self, surface: Mapping[str, np.memmap]) -> np.ndarray:
+        self._validate_epoch()
+        tick_surface = int(np.asarray(surface["tick"], dtype=np.uint64)[0])
+        tick_sidecar = int(np.fromfile(self.tick_path, dtype="<u8", count=1)[0])
+        if tick_sidecar != tick_surface:
+            raise SurfaceStateIntegrityError(f"spinor_tick mismatch: {tick_sidecar} != {tick_surface}")
+        turns = np.fromfile(self.turns_path, dtype="<i8", count=N_OSCILLATORS)
+        if turns.shape != (N_OSCILLATORS,):
+            raise SurfaceStateIntegrityError("spinor turns cardinality mismatch")
+        return turns.astype(np.int64, copy=True)
+
+    def commit(self, turns: np.ndarray, tick: int) -> None:
+        self._validate_epoch()
+        turns_arr = np.asarray(turns, dtype="<i8").reshape(N_OSCILLATORS)
+        tick_arr = np.asarray([int(tick)], dtype="<u8")
+        _spinor_atomic_bytes(self.turns_path, turns_arr.tobytes(order="C"))
+        _spinor_atomic_bytes(self.tick_path, tick_arr.tobytes(order="C"))
+
+    def snapshot(self, surface: Mapping[str, np.memmap]) -> dict[str, Any]:
+        turns = self.begin(surface)
+        tick = int(np.asarray(surface["tick"], dtype=np.uint64)[0])
+        return {
+            "schema": "NOEMA-QHTRI-SPINOR-LIFT-SNAPSHOT/0.2",
+            "qhtri_tick": tick,
+            "turns": [int(x) for x in turns],
+            "spinor_sheet": [int(x) for x in _spinor_sheet(turns)],
+            "epoch_sha256": self._validate_epoch()["epoch_sha256"],
+        }
+
