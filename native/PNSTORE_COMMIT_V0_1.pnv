PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# Logical PNStore commit witness. Physical block effects remain backend-gated.

OP STORE.OBJECT.SOURCE SOURCE pnobject.candidate
OP STORE.OBJECT.VERIFY IDENTITY STORE.OBJECT.SOURCE
OP STORE.PARENT.SOURCE SOURCE pnstore.current_generation
OP STORE.PARENT.VERIFY IDENTITY STORE.PARENT.SOURCE
OP STORE.ORDER ORDER STORE.PARENT.VERIFY STORE.OBJECT.VERIFY
OP STORE.GENERATION.TRANSFORM TRANSFORM STORE.ORDER pnobject.generation_candidate
OP STORE.COMMIT.COMPOSE COMPOSITION STORE.GENERATION.TRANSFORM pnstore.commit_evidence
OP STORE.COMMIT.CONDITION CONDITION STORE.COMMIT.COMPOSE commit_admitted
OP STORE.HEAD.TRANSFORM TRANSFORM STORE.COMMIT.CONDITION pnstore.next_head_candidate
OP STORE.RETURN RETURN STORE.HEAD.TRANSFORM

ASSERT STORE.OBJECT.VERIFY
ASSERT STORE.PARENT.VERIFY
ASSERT STORE.COMMIT.CONDITION
EMIT STORE.RETURN

# EXACTLY_ONCE_TRANSITION_ID REQUIRED
# COMMITTED_GENERATIONS_IMMUTABLE TRUE
# PHYSICAL_EFFECT_AUTHORITY CLOSED
# NEW_PNV_OPCODES 0
