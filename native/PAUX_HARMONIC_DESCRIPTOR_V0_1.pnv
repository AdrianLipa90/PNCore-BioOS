PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# Exact rational harmonic-orbital descriptor for derived PAUX memory indexing.

OP HOD.STATE.SOURCE SOURCE pnv_state_memory.object
OP HOD.STATE.VERIFY IDENTITY HOD.STATE.SOURCE
OP HOD.BAND.SOURCE SOURCE paux.harmonic_band_id
OP HOD.BAND.CONDITION CONDITION HOD.BAND.SOURCE h_band_namespace_h0_h35
OP HOD.RATIO.SOURCE SOURCE paux.harmonic_ratio_integer_pair
OP HOD.RATIO.CONDITION CONDITION HOD.RATIO.SOURCE positive_coprime_ratio
OP HOD.WINDING.SOURCE SOURCE paux.orbital_winding_integer
OP HOD.WINDING.CONDITION CONDITION HOD.WINDING.SOURCE positive_winding
OP HOD.GEOMETRY.ORDER ORDER HOD.RATIO.CONDITION HOD.WINDING.CONDITION
OP HOD.WAVELENGTH.TRANSFORM TRANSFORM HOD.GEOMETRY.ORDER exact_reciprocal_wavelength_ratio
OP HOD.RADIUS.TRANSFORM TRANSFORM HOD.WAVELENGTH.TRANSFORM exact_orbital_radius_ratio
OP HOD.PHASE.SOURCE SOURCE paux.phase_source_evidence
OP HOD.PHASE.VERIFY IDENTITY HOD.PHASE.SOURCE
OP HOD.DESCRIPTOR.COMPOSE COMPOSITION HOD.STATE.VERIFY HOD.BAND.CONDITION HOD.RADIUS.TRANSFORM HOD.PHASE.VERIFY
OP HOD.INDEX.TRANSFORM TRANSFORM HOD.DESCRIPTOR.COMPOSE paux.derived_harmonic_orbital_index
OP HOD.EVIDENCE.COMPOSE COMPOSITION HOD.INDEX.TRANSFORM paux.harmonic_geometry_receipt
OP HOD.RETURN RETURN HOD.EVIDENCE.COMPOSE

ASSERT HOD.STATE.VERIFY
ASSERT HOD.BAND.CONDITION
ASSERT HOD.RATIO.CONDITION
ASSERT HOD.WINDING.CONDITION
ASSERT HOD.PHASE.VERIFY
ASSERT HOD.EVIDENCE.COMPOSE
EMIT HOD.RETURN

# MEMORY_BAND_NAMESPACE H0..H35
# SCHEDULER_BAND_NAMESPACE B0..B7
# RATIO_ARITHMETIC EXACT_POSITIVE_INTEGER
# RATIO_NORMAL_FORM COPRIME
# WAVELENGTH_RATIO q/p
# RADIUS_RATIO_REFERENCE N*q/(N0*p)
# ORBIT_CLOSURE 2PI_R_EQ_N_LAMBDA
# AUTHORITY_CLASS DERIVED_INDEX
# SOURCE_OBJECT_ID PNV_STATE_OBJECT.object_id
# DERIVATION_ID REQUIRED
# OBJECT_ID_AUTHORITY PNV_STATE_OBJECT
# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
