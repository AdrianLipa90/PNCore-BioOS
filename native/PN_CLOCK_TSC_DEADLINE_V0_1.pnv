PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PN Clock candidate: exact rational x86 TSC-deadline realization.

OP CLOCK.CAP.SOURCE SOURCE hardware.x86.cpuid
OP CLOCK.CAP.VERIFY IDENTITY CLOCK.CAP.SOURCE
OP CLOCK.TIMELINE.SOURCE SOURCE hardware.x86.tsc
OP CLOCK.TIMELINE.VERIFY IDENTITY CLOCK.TIMELINE.SOURCE
OP CLOCK.RATIO.ORDER ORDER CLOCK.CAP.VERIFY CLOCK.TIMELINE.VERIFY
OP CLOCK.RATIO.TRANSFORM TRANSFORM CLOCK.RATIO.ORDER pnclock.rational_783_100
OP CLOCK.PHASE.SOURCE SOURCE pnscheduler.tick_index
OP CLOCK.DEADLINE.ORDER ORDER CLOCK.PHASE.SOURCE CLOCK.RATIO.TRANSFORM
OP CLOCK.DEADLINE.TRANSFORM TRANSFORM CLOCK.DEADLINE.ORDER pnclock.absolute_deadline
OP CLOCK.FUTURE.CONDITION CONDITION CLOCK.DEADLINE.TRANSFORM future_deadline
OP CLOCK.SKIP.TRANSFORM TRANSFORM CLOCK.FUTURE.CONDITION pnclock.skip_missed_windows
OP CLOCK.EVIDENCE.COMPOSE COMPOSITION CLOCK.SKIP.TRANSFORM pnclock.jitter_evidence
OP CLOCK.RETURN RETURN CLOCK.EVIDENCE.COMPOSE

ASSERT CLOCK.CAP.VERIFY
ASSERT CLOCK.TIMELINE.VERIFY
ASSERT CLOCK.FUTURE.CONDITION
EMIT CLOCK.RETURN

# BASE_FREQUENCY_RATIONAL 783/100 HZ
# ABSOLUTE_PHASE_INDEX TRUE
# MISSED_WINDOW SKIP
# CATCH_UP DENY
# FLOAT_TIMER_PATH FALSE
# NEW_PNV_OPCODES 0
