PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

OP BR.EVENT.SOURCE SOURCE noema.qhtri.live_bifurcation_event
OP BR.EVENT.IDENTITY IDENTITY BR.EVENT.SOURCE
OP BR.STATE.SOURCE SOURCE noema.qhtri.bifurcation_ring_state
OP BR.STATE.IDENTITY IDENTITY BR.STATE.SOURCE
OP BR.CURSOR.SOURCE SOURCE noema.qhtri.noema_ring_cursor
OP BR.CURSOR.IDENTITY IDENTITY BR.CURSOR.SOURCE

OP BR.L0.CONDITION CONDITION BR.EVENT.IDENTITY autonomy_level_l0_observe_interpret
OP BR.TRANSPORT.CONDITION CONDITION BR.EVENT.IDENTITY runtime_write_scope_transport_only
OP BR.SEQUENCE.CONDITION CONDITION BR.STATE.IDENTITY producer_sequence_monotonic
OP BR.TICK.CONDITION CONDITION BR.STATE.IDENTITY qhtri_tick_strictly_increasing
OP BR.PARENT.CONDITION CONDITION BR.EVENT.IDENTITY parent_record_commitment_valid
OP BR.RECORD.CONDITION CONDITION BR.EVENT.IDENTITY header_payload_footer_commitment_valid
OP BR.CURSOR.CONDITION CONDITION BR.CURSOR.IDENTITY exact_next_ack_sequence
OP BR.OVERFLOW.CONDITION CONDITION BR.STATE.IDENTITY fail_closed_no_unread_overwrite

OP BR.CHAIN.01 COMPOSITION BR.L0.CONDITION BR.TRANSPORT.CONDITION
OP BR.CHAIN.02 COMPOSITION BR.SEQUENCE.CONDITION BR.TICK.CONDITION
OP BR.CHAIN.03 COMPOSITION BR.PARENT.CONDITION BR.RECORD.CONDITION
OP BR.CHAIN.04 COMPOSITION BR.CURSOR.CONDITION BR.OVERFLOW.CONDITION
OP BR.ORDER.01 ORDER BR.CHAIN.01 BR.CHAIN.02
OP BR.ORDER.02 ORDER BR.ORDER.01 BR.CHAIN.03
OP BR.ORDER.03 ORDER BR.ORDER.02 BR.CHAIN.04
OP BR.RETURN RETURN BR.ORDER.03

ASSERT BR.EVENT.IDENTITY
ASSERT BR.STATE.IDENTITY
ASSERT BR.CURSOR.IDENTITY
ASSERT BR.L0.CONDITION
ASSERT BR.TRANSPORT.CONDITION
ASSERT BR.SEQUENCE.CONDITION
ASSERT BR.TICK.CONDITION
ASSERT BR.PARENT.CONDITION
ASSERT BR.RECORD.CONDITION
ASSERT BR.CURSOR.CONDITION
ASSERT BR.OVERFLOW.CONDITION
EMIT BR.RETURN

# AUTONOMY_LEVEL L0_OBSERVE_INTERPRET
# RUNTIME_WRITE_SCOPE TRANSPORT_ONLY
# PRODUCER QHTRI
# CONSUMER NOEMA
# OVERFLOW_POLICY FAIL_CLOSED_NO_UNREAD_OVERWRITE
# EVENT_CHAIN CONTENT_ADDRESSED
# NOEMA_ACK EXACT_ORDER
# LIVE_SURFACE /dev/shm/ciel_noema
# NEW_PNV_OPCODES 0
