# PNAML v1.1 communication profile; existing Bio-OS/QHTRI is the only dynamics engine.
LANGUAGE PNAML 1.1
ENGINE OWNER_EXISTING_PNCORE_BIOOS_QHTRI
SENDER ANY_NOEMA_MODULE
RECEIVER ANY_NOEMA_MODULE
PHASE_LANE AUX_T36_CONTINUOUS_SOURCE_WITH_NATIVE_COHERENT_SNAPSHOT_HANDOFF
PHASE_REPRESENTATION NATIVE_F64x36_288_BYTES
SEMANTIC_LANE FULL_EXACT_RDSS_PNCS_OPAQUE_OCTETS_WITH_ORIGINAL_ROLES
SEMANTIC_DECODING KNOWN_PNCS_KEYS_ONLY_UNKNOWN_PASS_THROUGH
FULL_STATE CANNOT_RECONSTRUCT_FROM_PHASE_PROJECTION
IDENTITY SOURCE_EXACT_PNCS_ID_AND_ORDERED_RELATIONS_NOT_SIMILARITY
BRAID EXACT_ORDERED_WORD_PRESERVE_NO_PERMUTATION_ONLY_SHORTCUT
TRIT_ADAPTER OPTIONAL_OBSERVATION_ONLY_12_TRIT_NO_AUTO_COLLAPSE
TORUS T36_2PI
SPINOR CIEL_NATIVE_4PI_DISTINCT
TEMPORAL_LIFT PRESERVE_IN_FULL_STATE_LANE_AND_TRANSPORT_PHASE_SAMPLES
EXECUTION PNCORE_NATIVE_X86_64_PNAML_SPSC_SNAPSHOT
ABI SLOT_VERSION_U64_CAPACITY_U64_LENGTH_U64_GENERATION_U64_SEQUENCE_U64_PUBLISHED_U64_PHASE_F64x36_PAYLOAD_BYTES
SEND PNCORE_PNAML_PUBLISH
RECEIVE PNCORE_PNAML_CONSUME
EFFECTS SEPARATE_FROM_COMMUNICATION_EXISTING_PNCAP_GREMLIN
UNKNOWN_TYPES PRESERVE_OPAQUE
UNMATCHED_ROLE PRESERVE_OPAQUE
NEW_PNV_OPCODES 0
ADDITIONAL_DYNAMICS_ENGINE NONE
JSONL_LIVE_TRANSPORT NONE
TESTED_SCOPE ISOLATED_SHARED_MEMORY_X86_64_NOT_HOST_AUX
