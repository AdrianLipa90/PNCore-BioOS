# PNAML 1.0 candidate — intra-system machine communication over AUX; not a digital wire format.
# Native execution is owned by existing PNCore-BioOS/QHTRI and PNCS operator registries.
LANGUAGE PNAML 1.0
TRANSPORT AUX CONTINUOUS_36D_PHASE_POTENTIAL
ENGINE EXISTING_PNCORE_BIOOS_QHTRI_M0_M11
SEMANTIC_OWNER PNCS_TYPED_CONTENT_AND_ORDER
RELATIONAL_OWNER RDSS_SIGNATURE_AND_OCCURRENCE
LINGUISTIC_OWNER CIELINGO_NATIVE_SEMANTIC_STATE
ONTOLOGY_OWNER THE_CONSCIOUSNESS_DICTIONARY
PROVENANCE_OWNER GREMLIN_M10
LANES FULL_STATE PAUX_EXACT_TYPED_36D_AND_RDSS
LANES PHASE_SIGNAL AUX_36D_LIFTED_WINDING
PHASE_ALPHABET 12_TRITS_3_CHANNELS_EACH
STATE_DISTINCTION FULL_RELATIONAL_STATE_NE_SPECTRAL_FINGERPRINT
TIME CONTINUOUS_TAU_WITH_EXPLICIT_REFERENCE
GATE_ORDER EXACT_TYPED_ORDERED_BRAID_WORD
GEOMETRY PHASE_T36_2PI SPINOR_4PI TRACK_LIFTED_WINDING
SCALARS MASS_PNCS_TYPED_DIAGNOSTIC ETHICS_CIEL_TYPED_DIAGNOSTIC
ROLE_PRESERVATION ORIGINAL_OPERATOR_REMAINS_OPERATOR
SEMANTIC_IDENTITY EXACT_TYPED_KEY_NOT_PHASE_SIMILARITY
PRODUCER BIOOS_M6_M7_M8_M9_M10_PNCS_RDSS
CONSUMER BIOOS_PAUX_EXACT_REFERENCE_AND_MATCHED_PHASE
REPLAY SOURCE_GENERATION_AND_MONOTONE_SEQUENCE
OBSERVATION EXPLICIT_SEPARATE_PROGRAM_NOT_IN_CONTINUOUS_WAVE_PATH
AUTHORIZATION USE_EXISTING_NATIVE_EFFECT_BOUNDARIES_NOT_PHASE_SIMILARITY
PNV_GRAMMARS BIOOS_PNV_PROGRAM PNCS_PNV_1
ADDITIONAL_EXECUTOR NONE
ADDITIONAL_PNV_OPCODES NONE
TRANSPORT_JSONL NONE
LANGUAGE_PYTHON_RUNTIME NONE
LANGUAGE_CPP_RUNTIME NONE
LANGUAGE_RUST_RUNTIME NONE
DEPLOYMENT FEATURE_BRANCHES_ONLY_NO_DEFAULT_RUNTIME_SWAP
