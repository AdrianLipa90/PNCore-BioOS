PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNCAP generation-bound capability admission witness.

OP CAP.PRINCIPAL.SOURCE SOURCE pncap.principal
OP CAP.PRINCIPAL.VERIFY IDENTITY CAP.PRINCIPAL.SOURCE
OP CAP.TARGET.SOURCE SOURCE pncap.target_generation
OP CAP.TARGET.VERIFY IDENTITY CAP.TARGET.SOURCE
OP CAP.GRANT.SOURCE SOURCE pncap.grant
OP CAP.GRANT.VERIFY IDENTITY CAP.GRANT.SOURCE
OP CAP.IDENTITY.ORDER ORDER CAP.PRINCIPAL.VERIFY CAP.TARGET.VERIFY
OP CAP.AUTH.ORDER ORDER CAP.IDENTITY.ORDER CAP.GRANT.VERIFY

OP CAP.REQUEST.SOURCE SOURCE pncap.operation_request
OP CAP.REQUEST.TRANSFORM TRANSFORM CAP.REQUEST.SOURCE exact_target_operation
OP CAP.COUPLING.COMPOSE COMPOSITION CAP.AUTH.ORDER CAP.REQUEST.TRANSFORM
OP CAP.ADMISSION.CONDITION CONDITION CAP.COUPLING.COMPOSE generation_bound_capability_match
OP CAP.TRANSITION.TRANSFORM TRANSFORM CAP.ADMISSION.CONDITION admitted_object_transition
OP CAP.EVIDENCE.COMPOSE COMPOSITION CAP.TRANSITION.TRANSFORM pncap.transition_evidence
OP CAP.RETURN RETURN CAP.EVIDENCE.COMPOSE

ASSERT CAP.PRINCIPAL.VERIFY
ASSERT CAP.TARGET.VERIFY
ASSERT CAP.GRANT.VERIFY
ASSERT CAP.ADMISSION.CONDITION
EMIT CAP.RETURN

# DEFAULT_GRANT_COUNT 0
# INITIAL_DELEGATION_POLICY NO_DELEGATION
# NEW_PNV_OPCODES 0
