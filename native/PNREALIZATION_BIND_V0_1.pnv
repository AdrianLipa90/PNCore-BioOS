PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP PNR.SOURCE SOURCE program.authority
OP PNR.IDENTITY IDENTITY PNR.SOURCE
OP PNR.ARCH SOURCE architecture.environment
OP PNR.ARCH.IDENTITY IDENTITY PNR.ARCH
OP PNR.ORDER ORDER PNR.IDENTITY PNR.ARCH.IDENTITY
OP PNR.REALIZE TRANSFORM PNR.ORDER architecture.physical_realization
OP PNR.ADMIT CONDITION PNR.REALIZE realization_identity_bound
OP PNR.STATE TRANSFORM PNR.ADMIT physical_state_candidate
OP PNR.EVIDENCE COMPOSITION PNR.STATE realization.evidence
OP PNR.RETURN RETURN PNR.EVIDENCE

ASSERT PNR.IDENTITY
ASSERT PNR.ARCH.IDENTITY
ASSERT PNR.ADMIT
EMIT PNR.RETURN

# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
# STATIC_RUNTIME_FALLBACK FALSE
