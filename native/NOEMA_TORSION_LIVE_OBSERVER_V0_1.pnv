PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP OBS.TELEMETRY.SOURCE SOURCE noema.qhtri.direct_telemetry
OP OBS.OMEGA.HASH IDENTITY OBS.TELEMETRY.SOURCE
OP OBS.CANDIDATE.TRANSFORM TRANSFORM OBS.OMEGA.HASH bounded_pair_rational_precompile
OP OBS.DETUNING.CONDITION CONDITION OBS.CANDIDATE.TRANSFORM relative_detuning_le_0p002
OP OBS.PHASE.TRANSFORM TRANSFORM OBS.DETUNING.CONDITION generalized_mn_phase_residual
OP OBS.COHERENCE.TRANSFORM TRANSFORM OBS.PHASE.TRANSFORM four_window_phase_lock_coherence
OP OBS.EDGE.CONDITION CONDITION OBS.COHERENCE.TRANSFORM r_ge_0p90_three_of_four
OP OBS.TORSION.TRANSFORM TRANSFORM OBS.EDGE.CONDITION tau_from_circular_mean
OP OBS.COUPLING.TRANSFORM TRANSFORM OBS.TORSION.TRANSFORM degree_max_kappa_policy
OP OBS.AUTH.CONDITION CONDITION OBS.COUPLING.TRANSFORM observer_only_no_effect_authority
OP OBS.RETURN RETURN OBS.AUTH.CONDITION

ASSERT OBS.DETUNING.CONDITION
ASSERT OBS.EDGE.CONDITION
ASSERT OBS.AUTH.CONDITION
EMIT OBS.RETURN

# SOURCE_WRITE NONE
# PNCAP_ACTION NONE
# AUX_EFFECT NONE
# NEW_PNV_OPCODES 0
