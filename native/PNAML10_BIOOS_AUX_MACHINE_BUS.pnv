PNV.PROGRAM PNAML10_BIOOS_AUX_MACHINE_BUS
PNV.VERSION 1.0
PNV.STATUS CROSS_STACK_INTEGRATION_CANDIDATE
PNV.EPISTEMIC CHYBA
PNV.CANON_ALLOWED false

REQUIRE T36_PHASE_FIELD
REQUIRE QHTRI_M0_M11_ANALOG_GATE_FABRIC_V0_1
REQUIRE QHTRI_TORSION_FLOW
REQUIRE PAUX_EXACT_FULL_STATE_LANE
REQUIRE PNCS_TYPED_CONTENT_AND_ORDER
REQUIRE RDSS_TYPED_RELATIONAL_OCCURRENCE
REQUIRE CIEL_NATIVE_SEMANTIC_STATE_V1
INVARIANT DIMENSION 36
INVARIANT TRIT_GROUPS 12
INVARIANT PNCS_OPERATOR_TYPE PRESERVE_SOURCE
INVARIANT RDSS_OCCURRENCE_AND_BRAID_WORD PRESERVE_SOURCE
INVARIANT NO_NEW_EXECUTOR true
INVARIANT NO_EARLY_COLLAPSE true
INVARIANT SPECTRAL_FINGERPRINT_NOT_FULL_STATE true
INVARIANT CONTINUOUS_SOURCE_AND_REFERENCE_SAME_GENERATION true

OP PNAML10_MACHINE_TX
  INPUT typed_pncs_content ordered_kaku typed_rdss_occurrence ordered_braid_word
  INPUT theta_initial[36] omega[36] amplitudes[36] tau_start tau_end
  USE QHTRI_M0_M11_ANALOG_GATE_FABRIC_V0_1
  USE M6_RELATIONAL_TORSION
  USE M7_DELIBERATION_BRAID
  USE M8_PROTECTED_IDENTITY
  USE M9_HOLONOMY
  USE M10_RECEIPT_PROVENANCE
  FIELD DTHETA_DT omega-GRAD(V_TOTAL)+F_M8
  SOURCE PNAML09_BIOOS_AUX_PRODUCER
  OUTPUT continuous_z[36](tau) exact_state_lane
END

OP PNAML10_MACHINE_RX
  INPUT continuous_z[36](tau) exact_state_lane
  REFERENCE PAUX_EXACT_FULL_STATE_LANE reference_theta_lifted[36](tau)
  SOURCE PNAML09_BIOOS_AUX_CONSUMER
  RECONSTRUCT lifted_phase_winding observed_trit[12] mass_projection ethics_projection
  PRESERVE exact_rdss_occurrence ordered_braid_word source_operator_type
  OUTPUT validated_typed_machine_observation
END

OP PNAML10_MACHINE_HANDOFF
  INPUT validated_typed_machine_observation source_generation source_sequence
  BIND PNCS_TYPED_CONTENT_AND_ORDER
  BIND RDSS_TYPED_RELATIONAL_OCCURRENCE
  BIND M10_RECEIPT_PROVENANCE
  OUTPUT non_actuating_internal_communication_receipt
END

COMPOSE
  TRANSMIT PNAML10_MACHINE_TX
  RECEIVE PNAML10_MACHINE_RX
  INTEGRATE PNAML10_MACHINE_HANDOFF
END
OUTPUT non_actuating_internal_communication_receipt
OUTPUT authority_grant=false
OUTPUT execution_admitted=false
