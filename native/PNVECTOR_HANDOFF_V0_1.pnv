PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP PNVH.SOURCE SOURCE current.vector36
OP PNVH.BASIS.IDENTITY IDENTITY PNCS_36D_BASIS_V0_1
OP PNVH.DIM.CONDITION CONDITION exact_36_finite_float64_ordered
OP PNVH.ORDER ORDER PNVH.BASIS.IDENTITY PNVH.DIM.CONDITION
OP PNVH.TRANSFORM TRANSFORM PNVH.SOURCE pnvector.handoff
OP PNVH.COMPOSE COMPOSITION PNVH.ORDER PNVH.TRANSFORM
OP PNVH.RETURN RETURN PNVH.COMPOSE

ASSERT PNVH.BASIS.IDENTITY
ASSERT PNVH.DIM.CONDITION
ASSERT PNVH.COMPOSE
EMIT PNVH.RETURN

# BASIS_SEMANTIC_AXES_PENDING_CANON TRUE
# VECTOR_DIM 36
# SCALAR FLOAT64_LE
# STATIC_RUNTIME_FALLBACK FALSE
# NEW_PNV_OPCODES 0
# CANON_ALLOWED FALSE
