PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PAUX-R v0.2.6 stage-5 harmonic orbital reconstruction.

OP OR.SOURCE.OBJECT SOURCE pnv_state_memory.object
OP OR.SOURCE.VERIFY IDENTITY OR.SOURCE.OBJECT
OP OR.FITS.SOURCE SOURCE paux.stage2_hband_fit_set
OP OR.MODEL.TRANSFORM TRANSFORM OR.FITS.SOURCE paux.orbital_sincos_model
OP OR.RESIDUAL.TRANSFORM TRANSFORM OR.MODEL.TRANSFORM paux.source_minus_orbital_model
OP OR.QR8.TRANSFORM TRANSFORM OR.RESIDUAL.TRANSFORM paux.quantized_residual_int8_per_band_scale
OP OR.QR16.TRANSFORM TRANSFORM OR.RESIDUAL.TRANSFORM paux.quantized_residual_int16_per_band_scale
OP OR.RECON.MODEL TRANSFORM OR.MODEL.TRANSFORM paux.reconstruct_model_only
OP OR.RECON.QR8 TRANSFORM OR.QR8.TRANSFORM paux.reconstruct_model_qr8
OP OR.RECON.QR16 TRANSFORM OR.QR16.TRANSFORM paux.reconstruct_model_qr16
OP OR.METRICS.COMPOSE COMPOSITION OR.RECON.MODEL OR.RECON.QR8 OR.RECON.QR16
OP OR.QUALITY.CONDITION CONDITION OR.METRICS.COMPOSE paux.orbital_quality_gate_v0_1
OP OR.SELECT.TRANSFORM TRANSFORM OR.QUALITY.CONDITION smallest_passing_logical_representation
OP OR.ID.TRANSFORM TRANSFORM OR.SELECT.TRANSFORM paux.reconstruction_id
OP OR.AUTHORITY.CONDITION CONDITION OR.ID.TRANSFORM reconstruction_only
OP OR.EVIDENCE.COMPOSE COMPOSITION OR.AUTHORITY.CONDITION paux.orbital_reconstruction_receipt
OP OR.RETURN RETURN OR.EVIDENCE.COMPOSE

ASSERT OR.SOURCE.VERIFY
ASSERT OR.QUALITY.CONDITION
ASSERT OR.AUTHORITY.CONDITION
EMIT OR.RETURN

# PROFILE PAUX-R
# REPRESENTATIONS MODEL_ONLY MODEL_QR8 MODEL_QR16
# QUALITY_NRMSE_MAX 0.02
# QUALITY_MAX_ABS_NORM_MAX 0.02
# QUALITY_ENERGY_RATIO_MIN 0.98
# QUALITY_ENERGY_RATIO_MAX 1.02
# QUALITY_RELATION_RETENTION_MIN 0.95
# QUALITY_PHASE_MEAN_ERROR_RAD_MAX 0.05
# SOURCE_REFERENCE PNV_STATE_OBJECT.object_id
# RECONSTRUCTION_ID REQUIRED
# AUTHORITY_CLASS RECONSTRUCTION_ONLY
# EXACT_PROFILE_PRECEDENCE TRUE
# CAPABILITY_AUTHORITY PNCAP
# EFFECT_AUTHORITY AUX
# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
