PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP WPRINCIPAL.SOURCE SOURCE pncap.torsion_surface_writer_principal
OP WPRINCIPAL.IDENTITY IDENTITY WPRINCIPAL.SOURCE
OP WTARGET.SOURCE SOURCE noema.torsion_memory.target_generation
OP WTICK.SOURCE SOURCE noema.torsion_memory.source_tick
OP WHEAD.SOURCE SOURCE noema.torsion_memory.active_head
OP WPATHS.SOURCE SOURCE noema.torsion_memory.publish_paths
OP WTRANSITION.SOURCE SOURCE noema.torsion_memory.transition_id
OP WGRANT.SOURCE SOURCE pncap.torsion_surface_writer_grant
OP WBIND.COMPOSE COMPOSITION WPRINCIPAL.IDENTITY WGRANT.SOURCE
OP WTARGET.ORDER ORDER WTARGET.SOURCE WTICK.SOURCE
OP WFRESH.ORDER ORDER WTARGET.ORDER WHEAD.SOURCE
OP WREQUEST.COMPOSE COMPOSITION WFRESH.ORDER WPATHS.SOURCE
OP WREQUEST.TRANSITION.COMPOSE COMPOSITION WREQUEST.COMPOSE WTRANSITION.SOURCE
OP WADMIT.COMPOSE COMPOSITION WBIND.COMPOSE WREQUEST.TRANSITION.COMPOSE
OP WADMIT.CONDITION CONDITION WADMIT.COMPOSE exact_generation_tick_head_path_replay_admission
OP WOWNER.CONDITION CONDITION WADMIT.CONDITION admitted_host_writer_realization
OP WRETURN RETURN WOWNER.CONDITION

ASSERT WPRINCIPAL.IDENTITY
ASSERT WADMIT.CONDITION
ASSERT WOWNER.CONDITION
EMIT WRETURN

# PRINCIPAL NOEMA_TORSION_SURFACE_WRITER_V0_1
# OPERATION PUBLISH_DERIVED_TORSION_GENERATION
# PERMISSION_BYPASS DENIED
# NEW_PNV_OPCODES 0
