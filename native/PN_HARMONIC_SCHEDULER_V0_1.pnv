PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# Single-clock dyadic admission scheduler.
# B0 is a bounded service lane; B1+ are mutually exclusive admission classes.

OP PHS.CLOCK SOURCE scheduler.base_tick
OP PHS.CLOCK.IDENTITY IDENTITY PHS.CLOCK
OP PHS.SERVICE SOURCE scheduler.b0_service_budget
OP PHS.SERVICE.CONDITION CONDITION PHS.SERVICE bounded_service_lane
OP PHS.COUNTER SOURCE scheduler.tick_index
OP PHS.COUNTER.IDENTITY IDENTITY PHS.COUNTER
OP PHS.SELECT TRANSFORM PHS.COUNTER.IDENTITY dyadic_trailing_zero_selector
OP PHS.ADMISSION CONDITION PHS.SELECT exact_one_band_or_reserved_quiet
OP PHS.QUEUE SOURCE scheduler.wait_queue
OP PHS.COUPLE COMPOSITION PHS.QUEUE PHS.ADMISSION
OP PHS.NONREENTRANT CONDITION PHS.COUPLE running_means_skip
OP PHS.NOCATCHUP CONDITION PHS.NONREENTRANT missed_window_means_skip
OP PHS.TRANSITION TRANSFORM PHS.NOCATCHUP admitted_work_transition
OP PHS.EVIDENCE COMPOSITION PHS.TRANSITION scheduler.transition_evidence
OP PHS.RETURN RETURN PHS.EVIDENCE

ASSERT PHS.CLOCK.IDENTITY
ASSERT PHS.SERVICE.CONDITION
ASSERT PHS.COUNTER.IDENTITY
ASSERT PHS.ADMISSION
ASSERT PHS.NONREENTRANT
ASSERT PHS.NOCATCHUP
EMIT PHS.RETURN

# BASE_FREQUENCY_HZ 7.83
# BAND_SELECTOR band=1+nu2(n), n>=1
# ACTIVE_ADMISSION_BANDS B1..B7
# NU2_GE_7 RESERVED_QUIET
# B0_OVERLAPS_TICKS TRUE
# CATCH_UP FALSE
# RUNNING_REENTRY FALSE
# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
# STATIC_RUNTIME_FALLBACK FALSE
