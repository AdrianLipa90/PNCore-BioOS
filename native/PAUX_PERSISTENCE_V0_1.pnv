PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# Persistent AUX carrier binding for canonical PNV state objects.

OP PAUX.STATE.SOURCE SOURCE pnv_state_memory.object
OP PAUX.STATE.VERIFY IDENTITY PAUX.STATE.SOURCE
OP PAUX.AUX.SOURCE SOURCE aux.runtime_domain
OP PAUX.CAP.SOURCE SOURCE pncap.persistence_grant
OP PAUX.ADMISSION.ORDER ORDER PAUX.CAP.SOURCE PAUX.STATE.VERIFY
OP PAUX.CONTEXT.ORDER ORDER PAUX.AUX.SOURCE PAUX.ADMISSION.ORDER
OP PAUX.MATERIALIZE.TRANSFORM TRANSFORM PAUX.CONTEXT.ORDER paux.materialized_candidate
OP PAUX.STORE.COMPOSE COMPOSITION PAUX.MATERIALIZE.TRANSFORM pnstore.generation_prepare
OP PAUX.EVIDENCE.CONDITION CONDITION PAUX.STORE.COMPOSE persistence_admitted
OP PAUX.RETURN RETURN PAUX.EVIDENCE.CONDITION

ASSERT PAUX.STATE.VERIFY
ASSERT PAUX.ADMISSION.ORDER
ASSERT PAUX.EVIDENCE.CONDITION
EMIT PAUX.RETURN

# FILE_EXTENSION .paux
# OBJECT_ID_AUTHORITY PNV_STATE_OBJECT
# INTEGRITY_AUTHORITY PNV_STATE_OBJECT
# AUX_PATH_REQUIRED TRUE
# PNCAP_REQUIRED TRUE
# PNSTORE_GENERATION_BOUND TRUE
# MEDIA_ADAPTER_BEHIND_AUX TRUE
# LIVE_AUX_ENDPOINT_RENAME FALSE_V0_1
# NEW_PNV_OPCODES 0
