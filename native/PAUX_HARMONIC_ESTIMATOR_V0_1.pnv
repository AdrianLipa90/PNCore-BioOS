PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PAUX v0.2.6 stage-2 bounded harmonic estimator.

OP HE.WINDOW.SOURCE SOURCE paux.window_analytic
OP HE.WINDOW.VERIFY CONDITION HE.WINDOW.SOURCE t36_finite_monotonic_min8
OP HE.REFERENCE.SOURCE SOURCE pnclock.f0_rational_783_100
OP HE.RATIO.LATTICE.TRANSFORM TRANSFORM HE.REFERENCE.SOURCE paux.reduced_positive_ratio_lattice_q16
OP HE.NYQUIST.CONDITION CONDITION HE.RATIO.LATTICE.TRANSFORM paux.window_nyquist_guard_0_48
OP HE.FIT.TRANSFORM TRANSFORM HE.WINDOW.VERIFY paux.harmonic_least_squares_sincos
OP HE.FIT.COUPLE COMPOSITION HE.FIT.TRANSFORM HE.NYQUIST.CONDITION
OP HE.RESOLUTION.TRANSFORM TRANSFORM HE.WINDOW.VERIFY paux.window_frequency_resolution
OP HE.SCORE.TRANSFORM TRANSFORM HE.FIT.COUPLE paux.fit_score_sse_sst
OP HE.AMBIGUITY.TRANSFORM TRANSFORM HE.SCORE.TRANSFORM paux.resolution_separated_runner_up
OP HE.QUALITY.CONDITION CONDITION HE.AMBIGUITY.TRANSFORM paux.min_score_0_85_margin_0_05
OP HE.BAND.TRANSFORM TRANSFORM HE.QUALITY.CONDITION paux.hband_rational_fit_descriptor
OP HE.AUTHORITY.CONDITION CONDITION HE.BAND.TRANSFORM derived_index_only
OP HE.EVIDENCE.COMPOSE COMPOSITION HE.AUTHORITY.CONDITION paux.harmonic_estimator_receipt
OP HE.RETURN RETURN HE.EVIDENCE.COMPOSE

ASSERT HE.WINDOW.VERIFY
ASSERT HE.NYQUIST.CONDITION
ASSERT HE.AUTHORITY.CONDITION
EMIT HE.RETURN

# REFERENCE_FREQUENCY 783/100_HZ
# RATIO_Q_MAX 16
# RATIO_MIN 1/4
# RATIO_MAX 4/1
# NYQUIST_GUARD 0.48
# MIN_WINDOW_SAMPLES 8
# MIN_FIT_SCORE 0.85
# MIN_SCORE_MARGIN 0.05
# SUCCESS_CLASS RATIONAL_FIT
# FAIL_CLASS FREQUENCY_UNRESOLVED
# H_BANDS H0..H35
# SCHEDULER_BANDS B0..B7
# AUTHORITY_CLASS DERIVED_INDEX
# OBJECT_ID_AUTHORITY PNV_STATE_OBJECT
# CAPABILITY_AUTHORITY PNCAP
# EFFECT_AUTHORITY AUX
# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
