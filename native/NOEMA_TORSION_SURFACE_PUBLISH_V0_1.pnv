PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP PUB.HEAD.SOURCE SOURCE noema.torsion_memory.active_head
OP PUB.GENERATION.SOURCE SOURCE noema.torsion_memory.prepared_generation
OP PUB.GENERATION.IDENTITY IDENTITY PUB.GENERATION.SOURCE
OP PUB.SOURCE_TICK.SOURCE SOURCE noema.torsion_memory.source_tick
OP PUB.WRITER.SOURCE SOURCE pncap.surface_writer_grant
OP PUB.WRITER.CONDITION CONDITION PUB.WRITER.SOURCE exact_generation_writer_admission
OP PUB.PREPARE.ORDER ORDER PUB.GENERATION.IDENTITY PUB.SOURCE_TICK.SOURCE
OP PUB.ADMISSION.COMPOSE COMPOSITION PUB.PREPARE.ORDER PUB.WRITER.CONDITION
OP PUB.COMPLETE.CONDITION CONDITION PUB.ADMISSION.COMPOSE complete_generation_and_fresh_source_tick
OP PUB.FLIP.TRANSFORM TRANSFORM PUB.COMPLETE.CONDITION atomic_inactive_generation_publish_and_head_flip
OP PUB.EVIDENCE.COMPOSE COMPOSITION PUB.FLIP.TRANSFORM torsion_surface_publish_evidence
OP PUB.RETURN RETURN PUB.EVIDENCE.COMPOSE

ASSERT PUB.GENERATION.IDENTITY
ASSERT PUB.WRITER.CONDITION
ASSERT PUB.COMPLETE.CONDITION
EMIT PUB.RETURN

# OWNER_GATE FAIL_CLOSED
# SOURCE_CHANNEL_WRITES DENIED
# AUX_EFFECT NONE
# NEW_PNV_OPCODES 0
