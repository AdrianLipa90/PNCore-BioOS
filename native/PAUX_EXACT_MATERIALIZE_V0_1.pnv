PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP PX.AUX.SOURCE SOURCE aux.live_snapshot
OP PX.AUX.VERIFY IDENTITY PX.AUX.SOURCE
OP PX.STATE.TRANSFORM TRANSFORM PX.AUX.VERIFY pnv_state_memory.snapshot_exact
OP PX.STATE.VERIFY IDENTITY PX.STATE.TRANSFORM
OP PX.CAP.SOURCE SOURCE pncap.persistence_grant
OP PX.ADMISSION.ORDER ORDER PX.CAP.SOURCE PX.STATE.VERIFY
OP PX.MATERIALIZE.TRANSFORM TRANSFORM PX.ADMISSION.ORDER paux.exact_materialization
OP PX.RESTORE.TRANSFORM TRANSFORM PX.MATERIALIZE.TRANSFORM paux.shadow_restore
OP PX.EXACT.CONDITION CONDITION PX.RESTORE.TRANSFORM byte_identical_t36
OP PX.EVIDENCE.COMPOSE COMPOSITION PX.EXACT.CONDITION paux.exact_receipt
OP PX.RETURN RETURN PX.EVIDENCE.COMPOSE

ASSERT PX.AUX.VERIFY
ASSERT PX.STATE.VERIFY
ASSERT PX.EXACT.CONDITION
EMIT PX.RETURN

# PROFILE PAUX-EXACT
# FILE_EXTENSION .paux
# LIVE_SOURCE /dev/shm/ciel_noema
# RESTORE_FIRST SHADOW_ADMISSION_SURFACE
# T36_EXACT_BYTES 288
# NEW_PNV_OPCODES 0
