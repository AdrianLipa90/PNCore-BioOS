PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# BioOS binding to DNCrypt lossless binary-envelope transport profile.
# DNCrypt source: feat/dncrypt-v0.4-binary-envelope @ 88439967b97d4d607ab2c7d30211f91e1fe87a72

OP PNB.CANONICAL.ENVELOPE SOURCE dncrypt.authenticated_canonical_envelope
OP PNB.CODEC.IDENTITY IDENTITY dncrypt.binary-envelope.v0.1
OP PNB.PACK.AUTHORITY SOURCE pncap.persistence_transport.grant
OP PNB.PACK.CONDITION CONDITION PNB.PACK.AUTHORITY PNB.CODEC.IDENTITY
OP PNB.PACK.ORDER ORDER PNB.PACK.CONDITION PNB.CANONICAL.ENVELOPE
OP PNB.PACK TRANSFORM PNB.PACK.ORDER dncrypt.pack_envelope
OP PNB.BINARY.IDENTITY TRANSFORM PNB.PACK dncrypt.binary_envelope_id
OP PNB.STORE.RETURN RETURN PNB.BINARY.IDENTITY

OP PNB.STORED.BYTES SOURCE pnstore.generation.payload
OP PNB.UNPACK TRANSFORM PNB.STORED.BYTES dncrypt.unpack_envelope
OP PNB.CANONICAL.MATCH CONDITION PNB.UNPACK canonical_envelope_byte_identity
OP PNB.RECEIPT.VERIFY CONDITION PNB.UNPACK dncrypt.provenance_receipt_valid
OP PNB.AAD.MATCH CONDITION PNB.UNPACK bioos.expected_authenticated_aad_exact
OP PNB.RECOVER.COMPOSE COMPOSITION PNB.CANONICAL.MATCH PNB.RECEIPT.VERIFY PNB.AAD.MATCH
OP PNB.RECOVER.RETURN RETURN PNB.RECOVER.COMPOSE

ASSERT PNB.CODEC.IDENTITY
ASSERT PNB.PACK.CONDITION
ASSERT PNB.BINARY.IDENTITY
ASSERT PNB.CANONICAL.MATCH
ASSERT PNB.RECEIPT.VERIFY
ASSERT PNB.AAD.MATCH
EMIT PNB.STORE.RETURN
EMIT PNB.RECOVER.RETURN

# FROZEN_CRYPTO_PROTOCOL_MUTATION FALSE
# CANONICAL_OBJECT_ID_MUTATION FALSE
# BINARY_ENVELOPE_ID_IS_REPRESENTATION_ID TRUE
# PNSTORE_CRYPTO_IMPLEMENTATION FALSE
# STATIC_RUNTIME_FALLBACK FALSE
# NEW_PNV_OPCODES 0
# CANON_ALLOWED FALSE
