PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# Relational PNFS resolver witness.

OP FS.ROOT.SOURCE SOURCE pnfs.start_object
OP FS.ROOT.VERIFY IDENTITY FS.ROOT.SOURCE
OP FS.QUERY.SOURCE SOURCE pnfs.relation_query
OP FS.QUERY.TRANSFORM TRANSFORM FS.QUERY.SOURCE normalized_relation_query
OP FS.ORDER ORDER FS.ROOT.VERIFY FS.QUERY.TRANSFORM
OP FS.TRAVERSE.TRANSFORM TRANSFORM FS.ORDER relation_traversal_candidate
OP FS.UNIQUE.CONDITION CONDITION FS.TRAVERSE.TRANSFORM unique_current_generation
OP FS.RESULT.TRANSFORM TRANSFORM FS.UNIQUE.CONDITION resolved_pnobject_generation
OP FS.RETURN RETURN FS.RESULT.TRANSFORM

ASSERT FS.ROOT.VERIFY
ASSERT FS.UNIQUE.CONDITION
EMIT FS.RETURN

# PATH_IS_VIEW TRUE
# WALL_CLOCK_CONFLICT_RESOLUTION FALSE
# NEW_PNV_OPCODES 0
