PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP MO.BASIN.SOURCE SOURCE noema.torsion_memory_basin
OP MO.BASIN.VERIFY IDENTITY MO.BASIN.SOURCE
OP MO.CANDIDATE.TRANSFORM TRANSFORM MO.BASIN.VERIFY torsion_recall_candidate_rank
OP MO.EPOCH.SOURCE SOURCE noema.memory_epoch_current
OP MO.EPOCH.CONDITION CONDITION MO.CANDIDATE.TRANSFORM exact_memory_epoch_match
OP MO.LINEAGE.CONDITION CONDITION MO.EPOCH.CONDITION exact_lineage_match
OP MO.PNCAP.SOURCE SOURCE pncap.generation_bound_grant
OP MO.PNCAP.CONDITION CONDITION MO.LINEAGE.CONDITION pncap_exact_admission
OP MO.SCHEDULER.SOURCE SOURCE scheduler.current_admission
OP MO.SCHEDULER.CONDITION CONDITION MO.PNCAP.CONDITION scheduler_admitted_now
OP MO.AUX.SOURCE SOURCE aux.effect_boundary
OP MO.AUX.CONDITION CONDITION MO.SCHEDULER.CONDITION aux_available
OP MO.REQUEST.ORDER ORDER MO.AUX.CONDITION aux.admitted_memory_request
OP MO.EVIDENCE.COMPOSE COMPOSITION MO.REQUEST.ORDER noema.memory_orchestration_evidence
OP MO.RETURN RETURN MO.EVIDENCE.COMPOSE

ASSERT MO.BASIN.VERIFY
ASSERT MO.EPOCH.CONDITION
ASSERT MO.LINEAGE.CONDITION
ASSERT MO.PNCAP.CONDITION
ASSERT MO.SCHEDULER.CONDITION
ASSERT MO.AUX.CONDITION
EMIT MO.RETURN

# RECALL_AUTHORITY NONE
# CAPABILITY_AUTHORITY PNCAP
# EFFECT_AUTHORITY AUX
# STALE_MEMORY_EPOCH RESELECT
# SCHEDULER_QUIET NO_EFFECT
# NEW_PNV_OPCODES 0
