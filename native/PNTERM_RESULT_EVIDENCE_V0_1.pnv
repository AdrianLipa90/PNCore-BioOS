PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNTERM L4: result identity and transport evidence.

OP RESULT.SOURCE SOURCE pnterm.dispatch_result
OP RESULT.PAYLOAD.TRANSFORM TRANSFORM RESULT.SOURCE sha256_utf8_payload
OP RESULT.SEQ.CONDITION CONDITION RESULT.PAYLOAD.TRANSFORM tx_seq_monotonic_within_session
OP RESULT.IDENTITY.TRANSFORM TRANSFORM RESULT.SEQ.CONDITION content_address_result
OP RESULT.AUX.COMPOSE COMPOSITION RESULT.IDENTITY.TRANSFORM aux.term.tx
OP RESULT.EVIDENCE.COMPOSE COMPOSITION RESULT.AUX.COMPOSE pnterm.result_evidence
OP RESULT.RETURN RETURN RESULT.EVIDENCE.COMPOSE

ASSERT RESULT.SEQ.CONDITION
EMIT RESULT.RETURN

# SILENT_TRUNCATION DENY
# NEW_PNV_OPCODES 0
