PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNTERM L4/L5: typed Terminal36D execution and explicit capability/effect admission.

OP ADMIT.ACTION.SOURCE SOURCE terminal36d_action_packet
OP ADMIT.GATE.SELECT SELECTOR ADMIT.ACTION.SOURCE terminal36d_concept_gate_class
OP ADMIT.READ.CONDITION CONDITION ADMIT.GATE.SELECT read_or_vectorize_is_nonmutating
OP ADMIT.EXEC.CONDITION CONDITION ADMIT.GATE.SELECT execute_typed_requires_exact_typed_admission
OP ADMIT.MUTATE.CONDITION CONDITION ADMIT.GATE.SELECT write_or_copy_requires_exact_pncap_and_aux_effect_admission
OP ADMIT.AUTH.SELECT SELECTOR ADMIT.GATE.SELECT select_required_authority_path
OP ADMIT.AUTH.CONDITION CONDITION ADMIT.AUTH.SELECT exact_principal_operation_session_epoch_action_target_binding
OP ADMIT.DISPATCH.COMPOSE COMPOSITION ADMIT.ACTION.SOURCE ADMIT.AUTH.CONDITION
OP ADMIT.EVIDENCE.TRANSFORM TRANSFORM ADMIT.DISPATCH.COMPOSE terminal36d_execution_receipt_plus_pnterm_result_binding
OP ADMIT.RETURN RETURN ADMIT.EVIDENCE.TRANSFORM

ASSERT ADMIT.AUTH.CONDITION
EMIT ADMIT.RETURN

# RESONANCE_AUTHORITY 0
# VECTOR_SIMILARITY_AUTHORITY 0
# ARBITRARY_SHELL 0
# NEW_PNV_OPCODES 0
