PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP PC.STATE.SOURCE SOURCE pnv_state_memory.object
OP PC.STATE.VERIFY IDENTITY PC.STATE.SOURCE
OP PC.KEY.TRANSFORM TRANSFORM PC.STATE.VERIFY paux.key_state
OP PC.REF.CONDITION CONDITION PC.KEY.TRANSFORM hash_equal_reference
OP PC.RUN.CONDITION CONDITION PC.KEY.TRANSFORM exact_frame_repeat
OP PC.DELTA.TRANSFORM TRANSFORM PC.KEY.TRANSFORM paux.delta_xor64_sparse
OP PC.CODEC.COMPOSE COMPOSITION PC.REF.CONDITION PC.RUN.CONDITION PC.DELTA.TRANSFORM
OP PC.DECODE.TRANSFORM TRANSFORM PC.CODEC.COMPOSE paux.lossless_decode
OP PC.EXACT.CONDITION CONDITION PC.DECODE.TRANSFORM pnv_state_object_exact_verify
OP PC.EVIDENCE.COMPOSE COMPOSITION PC.EXACT.CONDITION paux.lossless_receipt
OP PC.RETURN RETURN PC.EVIDENCE.COMPOSE

ASSERT PC.STATE.VERIFY
ASSERT PC.EXACT.CONDITION
EMIT PC.RETURN

# PROFILE PAUX-C
# LOSS_CLASS LOSSLESS
# TRANSFORMS KEYSTATE REF RUN DELTA_XOR64
# OBJECT_ID_AUTHORITY PNV_STATE_OBJECT
# EXACT_DECODE_REQUIRED TRUE
# NEW_PNV_OPCODES 0
