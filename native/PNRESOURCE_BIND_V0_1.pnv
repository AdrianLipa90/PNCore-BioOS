PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNResource physical-resource admission witness.
# Uses existing registered PNV operator names only.

OP PR.IDENTITY.SOURCE SOURCE resource.physical_identity
OP PR.IDENTITY.VERIFY IDENTITY resource.identity
OP PR.ENVIRONMENT.SOURCE SOURCE resource.topology_generation
OP PR.AUTHORITY.SOURCE SOURCE resource.capability_authority
OP PR.REQUEST.SOURCE SOURCE resource.bind_request
OP PR.COUPLING.TRANSFORM TRANSFORM PR.REQUEST.SOURCE resource.current_coupling
OP PR.ADMISSION.CONDITION CONDITION PR.COUPLING.TRANSFORM resource_binding_admitted
OP PR.TRANSITION.ORDER ORDER PR.ADMISSION.CONDITION PR.IDENTITY.VERIFY
OP PR.STATE.TRANSFORM TRANSFORM PR.TRANSITION.ORDER resource.generation_state
OP PR.EVIDENCE.COMPOSE COMPOSITION PR.STATE.TRANSFORM PR.ENVIRONMENT.SOURCE
OP PR.RETURN RETURN PR.EVIDENCE.COMPOSE

ASSERT PR.IDENTITY.VERIFY
ASSERT PR.ADMISSION.CONDITION
EMIT PR.RETURN

# PHYSICAL_RESOURCE_KIND REQUIRED
# TOPOLOGY_GENERATION_BINDING REQUIRED
# PNCAP_BINDING REQUIRED
# GENERATION_EVIDENCE REQUIRED
# STATIC_RUNTIME_FALLBACK FALSE
# NEW_PNV_OPCODES 0
