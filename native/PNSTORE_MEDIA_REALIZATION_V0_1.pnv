PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNStore byte-medium realization witness. Backend I/O authority remains closed.

OP STOREMEDIA.REQUEST.SOURCE SOURCE pnstore.commit_request
OP STOREMEDIA.REQUEST.VERIFY IDENTITY STOREMEDIA.REQUEST.SOURCE
OP STOREMEDIA.AUTHORITY.SOURCE SOURCE pnstore.backend_capability
OP STOREMEDIA.AUTHORITY.VERIFY IDENTITY STOREMEDIA.AUTHORITY.SOURCE
OP STOREMEDIA.ORDER ORDER STOREMEDIA.AUTHORITY.VERIFY STOREMEDIA.REQUEST.VERIFY
OP STOREMEDIA.EXTENT.TRANSFORM TRANSFORM STOREMEDIA.ORDER pnstore.prepared_extent
OP STOREMEDIA.SEAL.COMPOSE COMPOSITION STOREMEDIA.EXTENT.TRANSFORM pnstore.commit_seal
OP STOREMEDIA.SEAL.CONDITION CONDITION STOREMEDIA.SEAL.COMPOSE extent_valid
OP STOREMEDIA.HEAD.TRANSFORM TRANSFORM STOREMEDIA.SEAL.CONDITION pnstore.alternating_head_candidate
OP STOREMEDIA.RECOVER.COMPOSE COMPOSITION STOREMEDIA.HEAD.TRANSFORM pnstore.recovery_state
OP STOREMEDIA.RETURN RETURN STOREMEDIA.RECOVER.COMPOSE

ASSERT STOREMEDIA.REQUEST.VERIFY
ASSERT STOREMEDIA.AUTHORITY.VERIFY
ASSERT STOREMEDIA.SEAL.CONDITION
EMIT STOREMEDIA.RETURN

# MEDIA_BYTES 65536
# SECTOR_BYTES 512
# EXTENT_BYTES 4096
# MAX_GENERATIONS 15
# CRC32C_CASTAGNOLI TRUE
# APPEND_ONLY_GENERATIONS TRUE
# DUAL_HEAD_ALTERNATING TRUE
# EXACTLY_ONCE_HISTORICAL_SCAN TRUE
# DURABLE_BARRIER_BEFORE_HEAD REQUIRED
# DURABLE_BARRIER_AFTER_HEAD REQUIRED
# DEVICE_BACKEND_BOUND FALSE
# NEW_PNV_OPCODES 0
