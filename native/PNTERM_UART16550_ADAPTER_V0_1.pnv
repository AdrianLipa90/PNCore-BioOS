PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNTERM Stage 2: AUX -> admitted x86_64 UART16550 physical adapter.

OP UART.REQUEST.SOURCE SOURCE aux.term.physical_request
OP UART.ADAPTER.SOURCE SOURCE pnterm.uart16550.adapter_resource
OP UART.PNCAP.SOURCE SOURCE pncap.grant

OP UART.RESOURCE.IDENTITY IDENTITY UART.ADAPTER.SOURCE
OP UART.REQUEST.TRANSFORM TRANSFORM UART.REQUEST.SOURCE classify_aux_term_rx_or_tx
OP UART.ADMISSION.COMPOSE COMPOSITION UART.REQUEST.TRANSFORM UART.RESOURCE.IDENTITY UART.PNCAP.SOURCE
OP UART.ADMISSION.CONDITION CONDITION UART.ADMISSION.COMPOSE exact_adapter_base_operation_and_grant_match

OP UART.PROBE.TRANSFORM TRANSFORM UART.ADMISSION.CONDITION reversible_scratch_register_probe
OP UART.PROBE.CONDITION CONDITION UART.PROBE.TRANSFORM scratch_probe_match
OP UART.OP.SELECT SELECTOR UART.PROBE.CONDITION rx_tx_or_init
OP UART.PHYSICAL.TRANSFORM TRANSFORM UART.OP.SELECT bounded_uart16550_polling_transition
OP UART.EVIDENCE.COMPOSE COMPOSITION UART.PHYSICAL.TRANSFORM pnterm.uart16550.physical_evidence
OP UART.RETURN RETURN UART.EVIDENCE.COMPOSE

ASSERT UART.ADMISSION.CONDITION
ASSERT UART.PROBE.CONDITION
EMIT UART.RETURN

# ADAPTER_ID UART16550_POLL_V0_1
# DEFAULT_IO_BASE 0x03F8
# POLLING BOUNDED
# PHYSICAL_EXECUTION PENDING
# NEW_PNV_OPCODES 0
