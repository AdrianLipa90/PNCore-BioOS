PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# Fail-closed phase-source classification for PAUX harmonic orbital memory.

OP HPS.MODE.SOURCE SOURCE paux.phase_source_mode
OP HPS.MODE.CONDITION CONDITION HPS.MODE.SOURCE direct_window_unknown_enum
OP HPS.DIRECT.SOURCE SOURCE paux.direct_phase_t36
OP HPS.DIRECT.CONDITION CONDITION HPS.DIRECT.SOURCE direct_phase_exact_36_finite_when_selected
OP HPS.WINDOW.SOURCE SOURCE paux.timestamped_aux_window
OP HPS.WINDOW.CONDITION CONDITION HPS.WINDOW.SOURCE analytic_window_min4_width36_finite_monotonic_when_selected
OP HPS.SNAPSHOT.SOURCE SOURCE paux.source_snapshot
OP HPS.UNKNOWN.CONDITION CONDITION HPS.SNAPSHOT.SOURCE unresolved_snapshot_emits_phase_unknown
OP HPS.FEEDBACK.SOURCE SOURCE aux.feedback_channel_role
OP HPS.FEEDBACK.CONDITION CONDITION HPS.FEEDBACK.SOURCE quadrature_requires_explicit_admission
OP HPS.SELECT.ORDER ORDER HPS.MODE.CONDITION HPS.DIRECT.CONDITION HPS.WINDOW.CONDITION HPS.UNKNOWN.CONDITION HPS.FEEDBACK.CONDITION
OP HPS.CLASSIFY.TRANSFORM TRANSFORM HPS.SELECT.ORDER paux.phase_source_classify_fail_closed
OP HPS.EVIDENCE.COMPOSE COMPOSITION HPS.CLASSIFY.TRANSFORM paux.phase_source_receipt
OP HPS.RETURN RETURN HPS.EVIDENCE.COMPOSE

ASSERT HPS.MODE.CONDITION
ASSERT HPS.FEEDBACK.CONDITION
ASSERT HPS.EVIDENCE.COMPOSE
EMIT HPS.RETURN

# PHASE_SOURCE_MODES DIRECT_PHASE WINDOW_ANALYTIC PHASE_UNKNOWN
# DIRECT_PHASE_WIDTH 36
# WINDOW_MIN_SAMPLES 4
# WINDOW_CHANNEL_WIDTH 36
# WINDOW_TIMESTAMPS STRICTLY_INCREASING
# SINGLE_SNAPSHOT_WITHOUT_PHASE PHASE_UNKNOWN
# AUX_FEEDBACK_ROLE LIVE_FEEDBACK_CHANNEL
# QUADRATURE_ROLE EXPLICIT_ADMISSION_REQUIRED
# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
