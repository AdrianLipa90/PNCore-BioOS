PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNTERM L0: semantic terminal transport is AUX-owned.

OP TERM.RX.SOURCE SOURCE aux.term.rx_event
OP TERM.RX.IDENTITY IDENTITY TERM.RX.SOURCE
OP TERM.RX.CONDITION CONDITION TERM.RX.IDENTITY adapter_session_sequence_present

OP TERM.CHUNK.TRANSFORM TRANSFORM TERM.RX.CONDITION preserve_ordered_utf8_octets
OP TERM.LINE.BIND COMPOSITION TERM.CHUNK.TRANSFORM pnterm.line_discipline_v0_1

OP TERM.TX.REQUEST SOURCE pnterm.tx_result
OP TERM.TX.IDENTITY IDENTITY TERM.TX.REQUEST
OP TERM.TX.CONDITION CONDITION TERM.TX.IDENTITY bounded_result_and_session_match
OP TERM.TX.COMPOSE COMPOSITION TERM.TX.CONDITION aux.term.tx
OP TERM.EVIDENCE.COMPOSE COMPOSITION TERM.TX.COMPOSE pnterm.transport_evidence
OP TERM.RETURN RETURN TERM.EVIDENCE.COMPOSE

ASSERT TERM.RX.CONDITION
ASSERT TERM.TX.CONDITION
EMIT TERM.RETURN

# PHYSICAL_ADAPTER_AUTHORITY AUX
# DEFAULT_DIRECT_DEVICE_IO DENY
# NEW_PNV_OPCODES 0
