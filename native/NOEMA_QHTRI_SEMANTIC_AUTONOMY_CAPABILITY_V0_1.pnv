PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

OP SA.ACTION.SOURCE SOURCE noema.qhtri.semantic_action
OP SA.ACTION.IDENTITY IDENTITY SA.ACTION.SOURCE
OP SA.CAPABILITY.SOURCE SOURCE noema.qhtri.semantic_autonomy_capability
OP SA.CAPABILITY.IDENTITY IDENTITY SA.CAPABILITY.SOURCE
OP SA.FEEDBACK.SOURCE SOURCE noema.qhtri.feedback_candidate
OP SA.FEEDBACK.IDENTITY IDENTITY SA.FEEDBACK.SOURCE
OP SA.EPOCH.SOURCE SOURCE noema.qhtri.autonomy_epoch_state
OP SA.EPOCH.IDENTITY IDENTITY SA.EPOCH.SOURCE

OP SA.L0.CONDITION CONDITION SA.ACTION.IDENTITY observe_interpret_is_automatic
OP SA.L1.SCOPE CONDITION SA.CAPABILITY.IDENTITY bounded_internal_effect_scope_valid
OP SA.L1.EPOCH CONDITION SA.EPOCH.IDENTITY monotonic_effect_index_valid
OP SA.L1.FEEDBACK COMPOSITION SA.FEEDBACK.IDENTITY SA.L1.SCOPE
OP SA.L1.CHAIN COMPOSITION SA.L1.FEEDBACK SA.L1.EPOCH
OP SA.L1.CONDITION CONDITION SA.L1.CHAIN no_per_tick_human_authorization
OP SA.L2.CONDITION CONDITION SA.ACTION.IDENTITY authority_expansion_requires_explicit_admission

OP SA.AUTONOMY.ORDER.01 ORDER SA.L0.CONDITION SA.L1.CONDITION
OP SA.AUTONOMY.ORDER.02 ORDER SA.L1.CONDITION SA.L2.CONDITION
OP SA.AUTONOMY.CHAIN COMPOSITION SA.AUTONOMY.ORDER.01 SA.AUTONOMY.ORDER.02
OP SA.RETURN RETURN SA.AUTONOMY.CHAIN

ASSERT SA.ACTION.IDENTITY
ASSERT SA.CAPABILITY.IDENTITY
ASSERT SA.FEEDBACK.IDENTITY
ASSERT SA.EPOCH.IDENTITY
ASSERT SA.L0.CONDITION
ASSERT SA.L1.SCOPE
ASSERT SA.L1.EPOCH
ASSERT SA.L1.CONDITION
ASSERT SA.L2.CONDITION
EMIT SA.RETURN

# L0 OBSERVE_INTERPRET AUTOMATIC
# L1 BOUNDED_INTERNAL_EFFECT AUTOMATIC_UNDER_CAPABILITY
# L2 AUTHORITY_EXPANSION_OR_EXTERNAL_EFFECT EXPLICIT_ADMISSION
# HUMAN_PER_TICK_AUTHORIZATION L0_FALSE L1_FALSE L2_REQUIRED
# CAPABILITY_ISSUANCE PNCAP_AUTHORITY_SPINE
# EFFECT_INDEX OWNER SEMANTIC_AUTONOMY_EPOCH
# REPLAY ORDERED_FAIL_CLOSED
# EXTERNAL_EFFECT L1_FALSE
# CANON_WRITE_AUTHORITY L1_FALSE
# IDENTITY_AUTHORITY L1_FALSE
# NEW_PNV_OPCODES 0
