PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNTERM L2: line -> bounded tokens -> exact command identity.

OP CMD.LINE.SOURCE SOURCE pnterm.canonical_line
OP CMD.TOKEN.TRANSFORM TRANSFORM CMD.LINE.SOURCE bounded_single_pass_tokenizer
OP CMD.TOKEN.CONDITION CONDITION CMD.TOKEN.TRANSFORM max_32_tokens_max_256_bytes_each
OP CMD.VERB.CONDITION CONDITION CMD.TOKEN.CONDITION canonical_ascii_lowercase_verb
OP CMD.REGISTRY.SELECT SELECTOR CMD.VERB.CONDITION exact_readonly_registry_lookup
OP CMD.SESSION.SOURCE SOURCE pnterm.session
OP CMD.SEQ.CONDITION CONDITION CMD.SESSION.SOURCE rx_seq_strictly_greater_than_last_admitted
OP CMD.ENVELOPE.COMPOSE COMPOSITION CMD.REGISTRY.SELECT CMD.SEQ.CONDITION
OP CMD.IDENTITY.TRANSFORM TRANSFORM CMD.ENVELOPE.COMPOSE content_address_command_envelope
OP CMD.RETURN RETURN CMD.IDENTITY.TRANSFORM

ASSERT CMD.TOKEN.CONDITION
ASSERT CMD.VERB.CONDITION
ASSERT CMD.SEQ.CONDITION
EMIT CMD.RETURN

# SHELL_EXPANSION 0
# PIPE_REDIRECT_SUBSTITUTION 0
# NEW_PNV_OPCODES 0
