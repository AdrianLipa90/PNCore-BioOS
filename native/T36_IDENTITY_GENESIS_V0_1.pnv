PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# T36 Identity Crystal v0.1
# Uses existing PNCS operator classes only.
# No external effects are admitted by this program.

OP T36I.CLOCK.SOURCE SOURCE pnclock.current_admitted_clock
OP T36I.CLOCK.VERIFY IDENTITY T36I.CLOCK.SOURCE
OP T36I.PNVH.SOURCE SOURCE pnvector.current_handoff
OP T36I.PNVH.VERIFY IDENTITY T36I.PNVH.SOURCE
OP T36I.STORE.SOURCE SOURCE pnstore.current_generation
OP T36I.STORE.VERIFY IDENTITY T36I.STORE.SOURCE
OP T36I.MEMORY.SOURCE SOURCE pnv_state_memory.current

OP T36I.ORDER ORDER T36I.CLOCK.VERIFY T36I.PNVH.VERIFY T36I.STORE.VERIFY
OP T36I.RECOVER.TRANSFORM TRANSFORM T36I.MEMORY.SOURCE t36_identity.recovered_or_empty
OP T36I.GENESIS.CONDITION CONDITION T36I.RECOVER.TRANSFORM cold_genesis_or_verified_continuation
OP T36I.ANCHOR.TRANSFORM TRANSFORM T36I.GENESIS.CONDITION t36_identity.genesis_anchor
OP T36I.CRYSTAL.TRANSFORM TRANSFORM T36I.ANCHOR.TRANSFORM t36_identity.crystal_id
OP T36I.CONFIG.TRANSFORM TRANSFORM T36I.PNVH.VERIFY t36_identity.configuration_binding
OP T36I.SPINOR.TRANSFORM TRANSFORM T36I.CLOCK.VERIFY t36_identity.spinor_sheet_4pi

OP T36I.COMPOSE COMPOSITION T36I.ORDER T36I.CRYSTAL.TRANSFORM T36I.CONFIG.TRANSFORM T36I.SPINOR.TRANSFORM
OP T36I.ADMIT.CONDITION CONDITION T36I.COMPOSE identity_lineage_admitted
OP T36I.STATE.TRANSFORM TRANSFORM T36I.ADMIT.CONDITION t36_identity.state_record_256
OP T36I.RETURN RETURN T36I.STATE.TRANSFORM

ASSERT T36I.CLOCK.VERIFY
ASSERT T36I.PNVH.VERIFY
ASSERT T36I.STORE.VERIFY
ASSERT T36I.GENESIS.CONDITION
ASSERT T36I.ADMIT.CONDITION
EMIT T36I.RETURN

# CLOCK_F0_RATIONAL 783/100
# IDENTITY_FREQUENCY_RATIONAL 783/200
# VECTOR_DIM 36
# SPINOR_PERIOD 4PI
# SPINOR_SHEET phase_index&1
# RECORD_BYTES 256
# EVERY_TICK_PERSISTENCE FALSE
# STATIC_RUNTIME_FALLBACK FALSE
# EXTERNAL_EFFECTS FALSE
# NEW_PNV_OPCODES 0
# CANON_ALLOWED FALSE
