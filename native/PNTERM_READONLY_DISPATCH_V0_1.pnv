PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNTERM L3: exact registry command -> PNCAP -> read-only resolver.

OP DISPATCH.COMMAND.SOURCE SOURCE pnterm.command
OP DISPATCH.PRINCIPAL.SOURCE SOURCE pnterm.session_principal
OP DISPATCH.REGISTRY.TRANSFORM TRANSFORM DISPATCH.COMMAND.SOURCE exact_operation_and_capability_class
OP DISPATCH.PNCAP.SOURCE SOURCE pncap.grant
OP DISPATCH.PNCAP.COMPOSE COMPOSITION DISPATCH.PRINCIPAL.SOURCE DISPATCH.REGISTRY.TRANSFORM DISPATCH.PNCAP.SOURCE
OP DISPATCH.PNCAP.CONDITION CONDITION DISPATCH.PNCAP.COMPOSE exact_principal_operation_class_session_epoch_sequence_match
OP DISPATCH.RESOLVE.TRANSFORM TRANSFORM DISPATCH.PNCAP.CONDITION readonly_registry_resolver
OP DISPATCH.OUTPUT.CONDITION CONDITION DISPATCH.RESOLVE.TRANSFORM utf8_payload_le_4096
OP DISPATCH.RESULT.COMPOSE COMPOSITION DISPATCH.OUTPUT.CONDITION pnterm.result_v0_1
OP DISPATCH.RETURN RETURN DISPATCH.RESULT.COMPOSE

ASSERT DISPATCH.PNCAP.CONDITION
ASSERT DISPATCH.OUTPUT.CONDITION
EMIT DISPATCH.RETURN

# DEFAULT_WRITE_COMMANDS 0
# DEFAULT_UNKNOWN_COMMAND DENY
# AUX_EFFECT NONE
# NEW_PNV_OPCODES 0
