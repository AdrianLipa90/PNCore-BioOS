PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNCore generic admitted transition witness.
# Existing PNV operators only.

OP PNCORE.IDENTITY.SOURCE SOURCE current.identity
OP PNCORE.IDENTITY.VERIFY IDENTITY PNCORE.IDENTITY.SOURCE

OP PNCORE.ENV.SOURCE SOURCE current.environment
OP PNCORE.ENV.VERIFY IDENTITY PNCORE.ENV.SOURCE
OP PNCORE.ENV.ORDER ORDER PNCORE.IDENTITY.VERIFY PNCORE.ENV.VERIFY

OP PNCORE.AUTH.SOURCE SOURCE current.authority
OP PNCORE.AUTH.VERIFY IDENTITY PNCORE.AUTH.SOURCE
OP PNCORE.AUTH.ORDER ORDER PNCORE.ENV.ORDER PNCORE.AUTH.VERIFY

OP PNCORE.REQUEST.SOURCE SOURCE transition.request
OP PNCORE.REQUEST.TRANSFORM TRANSFORM PNCORE.REQUEST.SOURCE transition.candidate

OP PNCORE.COUPLING.TRANSFORM TRANSFORM PNCORE.AUTH.ORDER current.coupling
OP PNCORE.COUPLING.COMPOSE COMPOSITION PNCORE.REQUEST.TRANSFORM PNCORE.COUPLING.TRANSFORM

OP PNCORE.ADMISSION.CONDITION CONDITION PNCORE.COUPLING.COMPOSE admitted_transition
OP PNCORE.STATE.TRANSFORM TRANSFORM PNCORE.ADMISSION.CONDITION next_generation_state
OP PNCORE.EVIDENCE.COMPOSE COMPOSITION PNCORE.STATE.TRANSFORM transition.evidence
OP PNCORE.RETURN RETURN PNCORE.EVIDENCE.COMPOSE

ASSERT PNCORE.IDENTITY.VERIFY
ASSERT PNCORE.ENV.VERIFY
ASSERT PNCORE.AUTH.VERIFY
ASSERT PNCORE.ADMISSION.CONDITION
EMIT PNCORE.RETURN

# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
# STATIC_RUNTIME_FALLBACK FALSE
