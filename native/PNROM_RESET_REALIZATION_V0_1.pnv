PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNROM x86 reset realization witness.
# Physical architecture realization only; no new PNV opcode.

OP PR.IDENTITY SOURCE pnrom.image.identity
OP PR.ENVIRONMENT SOURCE x86.reset.environment
OP PR.AUTHORITY IDENTITY pnrom.x86_64.reset.contract
OP PR.REQUEST SOURCE power.on.request
OP PR.COUPLING TRANSFORM x86.reset.vector pnrom.entry
OP PR.ADMISSION CONDITION PR.IDENTITY PR.ENVIRONMENT PR.AUTHORITY PR.COUPLING
OP PR.TRANSITION ORDER PR.ADMISSION pnrom.entry
OP PR.STATE TRANSFORM PR.TRANSITION pncore.entry.candidate
OP PR.EVIDENCE COMPOSITION PR.IDENTITY PR.STATE
OP PR.RETURN RETURN PR.EVIDENCE

ASSERT PR.IDENTITY
ASSERT PR.AUTHORITY
ASSERT PR.ADMISSION
ASSERT PR.STATE
EMIT PR.RETURN

# TARGET_ARCH x86_64
# ROM_SIZE 65536
# RESET_VECTOR_OFFSET 0xFFF0
# RESET_VECTOR_LINEAR 0xFFFF0
# ENTRY_LINEAR 0xF0000
# BIOS_SERVICES FALSE
# STATIC_RUNTIME_FALLBACK FALSE
# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
# CANON_ALLOWED FALSE
