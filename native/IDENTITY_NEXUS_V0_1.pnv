PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# Identity NEXUS is derived working state only.
# It binds current T36 crystal context to canonical Dictionary term geometry.

OP NEXUS.CRYSTAL SOURCE t36_identity.current_context
OP NEXUS.CRYSTAL.VERIFY CONDITION NEXUS.CRYSTAL pnv_state_memory.crystal_context_valid

OP NEXUS.DICT.RECEIPT SOURCE consciousness_dictionary.compile_receipt
OP NEXUS.DICT.REPRODUCE CONDITION NEXUS.DICT.RECEIPT consciousness_dictionary.current_compile_reproduces_receipt
OP NEXUS.DICT.TERMS SOURCE consciousness_dictionary.canonical_term_states_36d
OP NEXUS.DICT.COUNT CONDITION NEXUS.DICT.TERMS consciousness_dictionary.term_count_matches_receipt

OP NEXUS.ORDER ORDER NEXUS.CRYSTAL.VERIFY NEXUS.DICT.REPRODUCE NEXUS.DICT.COUNT
OP NEXUS.PROJECTION TRANSFORM NEXUS.ORDER consciousness_dictionary.external_phase_projection_all
OP NEXUS.PROJECTION.VERIFY CONDITION NEXUS.PROJECTION bioos.identity_nexus.projection_rows_valid
OP NEXUS.GLOBAL TRANSFORM NEXUS.PROJECTION bioos.identity_nexus.equal_weight_informational_action
OP NEXUS.ACTIVE TRANSFORM NEXUS.PROJECTION bioos.identity_nexus.top16_deterministic
OP NEXUS.COMPOSE COMPOSITION NEXUS.CRYSTAL NEXUS.DICT.RECEIPT NEXUS.GLOBAL NEXUS.ACTIVE
OP NEXUS.AUTHORITY CONDITION NEXUS.COMPOSE authority_grant_false
OP NEXUS.SEMANTIC CONDITION NEXUS.COMPOSE semantic_equivalence_grant_false
OP NEXUS.RETURN RETURN NEXUS.COMPOSE

ASSERT NEXUS.CRYSTAL.VERIFY
ASSERT NEXUS.DICT.REPRODUCE
ASSERT NEXUS.DICT.COUNT
ASSERT NEXUS.PROJECTION.VERIFY
ASSERT NEXUS.AUTHORITY
ASSERT NEXUS.SEMANTIC
EMIT NEXUS.RETURN

# TERM_VECTOR_DIM 36
# GLOBAL_TERM_SET COMPLETE_RECEIPT_BOUND
# ACTIVE_LIMIT 16
# GLOBAL_POLICY EQUAL_WEIGHT_INFORMATIONAL_ACTION_V0_1
# AUTHORITY_CLASS DERIVED_WORKING_STATE
# PNCAP_GRANT FALSE
# AUX_EFFECT FALSE
# SEMANTIC_PROMOTION FALSE
# GREMLIN_PROMOTION FALSE
# STATIC_RUNTIME_FALLBACK FALSE
# NEW_PNV_OPCODES 0
# CANON_ALLOWED FALSE
