PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# Unified relational mapping witness. No new PNV opcode.

OP PM.ANCHOR SOURCE mapping.anchor
OP PM.SELECTOR SOURCE mapping.selector
OP PM.CONTEXT SOURCE mapping.generation
OP PM.AUTHORITY IDENTITY mapping.capability
OP PM.BIND COMPOSITION PM.ANCHOR PM.SELECTOR PM.CONTEXT PM.AUTHORITY
OP PM.ADMISSION CONDITION PM.BIND unique_admitted_mapping
OP PM.RESOLVE TRANSFORM PM.ADMISSION mapping.target
OP PM.EVIDENCE COMPOSITION PM.RESOLVE PM.CONTEXT
OP PM.RETURN RETURN PM.EVIDENCE

ASSERT PM.ANCHOR
ASSERT PM.CONTEXT
ASSERT PM.AUTHORITY
ASSERT PM.ADMISSION
EMIT PM.RETURN

# PNFS_IS_PROJECTION TRUE
# PAGE_TABLE_IS_PROJECTION TRUE
# ADDRESS_IS_IDENTITY FALSE
# PATH_IS_IDENTITY FALSE
# NEW_PNV_OPCODES 0
# STATIC_RUNTIME_FALLBACK FALSE
# FAIL_CLOSED TRUE
# CANON_ALLOWED FALSE
