PNV.PROGRAM QHTRI_TORUS_CHARACTER_FIELD_V0_2
PNV.VERSION 0.2
PNV.STATUS CANDIDATE
PNV.EPISTEMIC CHYBA
PNV.CANON_ALLOWED false

REQUIRE T36_PHASE_FIELD
REQUIRE M0_M11_SEMANTIC_BINDING
REQUIRE QHTRI_M0_M11_ANALOG_GATE_FABRIC_V0_1

INVARIANT DIMENSION 36
INVARIANT DUAL_LATTICE Z36
INVARIANT WHOLE_SEMANTIC_LANES true
INVARIANT COORDINATE_POSITION_MAPPING false
INVARIANT NO_GCD_NORMALIZATION true
INVARIANT M8_PROTECTED true
INVARIANT M10_APPEND_ONLY true
INVARIANT AUTHORITY_GRANT false
INVARIANT EXECUTION_ADMITTED false
INVARIANT STATIC_FALLBACK false

OP CHARACTER_TERM
  INPUT theta[36] ell[36]_integer tau gain
  REQUIRE ell_nonzero
  REQUIRE gain_finite_nonnegative
  POTENTIAL -gain*COS(DOT(ell,theta)-tau)
  FORCE -gain*SIN(DOT(ell,theta)-tau)*ell
  HESSIAN_BOUND gain*DOT(ell,ell)
END

OP ANCHOR_TO_CHARACTER
  INPUT lane_j target_j tau gain
  ELL unit_vector(j)
  PHASE_OFFSET target_j+tau
  OUTPUT CHARACTER_TERM(theta,ELL,PHASE_OFFSET,gain)
END

OP TORSION_TO_CHARACTER
  INPUT edge(i,j,m,n,tau,K,R)
  ELL n*unit_vector(i)-m*unit_vector(j)
  GAIN K*R
  OUTPUT CHARACTER_TERM(theta,ELL,tau,GAIN)
END

OP PHASE_CENTROID
  ROLE PARAMETER_REDUCER
  LAYERS M3 M7
  INDEPENDENT_FORCE_LAW false
END

OP CHARACTER_FIELD
  INPUT admitted_character_terms
  POTENTIAL SUM character_term_potentials
  FORCE SUM character_term_forces
  L_BOUND SUM gain*DOT(ell,ell)
END

OP GAIN_MODULATION
  LAYERS M4 M5 M11
  ROLE PARAMETER_MODULATOR
END

OP RECEIPT_OBSERVER
  LAYER M10
  FORCE ZERO
  MODE APPEND_ONLY
END

COMPOSE
  REDUCERS PHASE_CENTROID
  FORCE_KERNEL KCHI_CHARACTER_FIELD
  MODULATORS GAIN_MODULATION
  OBSERVER RECEIPT_OBSERVER
  FORCE_KERNEL_FAMILIES 3
END

OUTPUT character_field_commitment
OUTPUT operator_profile_commitment
OUTPUT authority_grant=false
OUTPUT execution_admitted=false

# K0_PHASE_LOCK_ANCHOR SPECIALIZES CHARACTER_TERM with ell=e_j
# K1_TORSION_COUPLING SPECIALIZES CHARACTER_TERM with ell=n*e_i-m*e_j
# XOR_XNOR SPECIALIZE CHARACTER_TERM with ell=e_a-e_b and tau=pi_or_0
# CHARACTER_GROUP chi_ell*chi_k=chi_(ell+k)
# ARBITRARY_DISTINCT_MODE_SUM_SINGLE_CHARACTER FALSE
# SAME_MODE_PHASOR_COMBINATION TRUE
# GCD_REDUCTION FALSE
# EXECUTION_AUTHORITY FALSE
