PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP PR.SOURCE.OBJECT SOURCE pnv_state_memory.object
OP PR.SOURCE.VERIFY IDENTITY PR.SOURCE.OBJECT
OP PR.MODEL.SOURCE SOURCE paux.relational_model
OP PR.SALIENCE.TRANSFORM TRANSFORM PR.SOURCE.VERIFY paux.t36_relational_salience
OP PR.ENCODE.COMPOSE COMPOSITION PR.MODEL.SOURCE PR.SALIENCE.TRANSFORM
OP PR.RECONSTRUCT.TRANSFORM TRANSFORM PR.ENCODE.COMPOSE paux.relational_reconstruct
OP PR.METRICS.TRANSFORM TRANSFORM PR.RECONSTRUCT.TRANSFORM paux.reconstruction_metrics
OP PR.QUALITY.CONDITION CONDITION PR.METRICS.TRANSFORM reconstruction_thresholds_admitted
OP PR.EVIDENCE.COMPOSE COMPOSITION PR.QUALITY.CONDITION paux.reconstruction_receipt
OP PR.RETURN RETURN PR.EVIDENCE.COMPOSE

ASSERT PR.SOURCE.VERIFY
ASSERT PR.QUALITY.CONDITION
EMIT PR.RETURN

# PROFILE PAUX-R
# AUTHORITY_CLASS RECONSTRUCTION_ONLY
# SOURCE_REFERENCE PNV_STATE_OBJECT.object_id
# RECONSTRUCTION_ID REQUIRED
# METRICS MAX_ABS_ERROR RMS_ERROR RELATION_RETENTION PHASE_DIAGNOSTICS
# NEW_PNV_OPCODES 0
