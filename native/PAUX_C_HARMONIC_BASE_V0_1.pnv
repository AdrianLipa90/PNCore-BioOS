PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PAUX-C v0.2.6 stage-4 harmonic candidate base selection.

OP HB.FRAME.SOURCE SOURCE paux_c.target_exact_frame
OP HB.PREVIOUS.SOURCE SOURCE paux_c.previous_exact_frame
OP HB.PHASE.SOURCE SOURCE paux.harmonic_phase_history
OP HB.PHASE.VERIFY CONDITION HB.PHASE.SOURCE resolved_hband_phase_evidence
OP HB.REVISIT.TRANSFORM TRANSFORM HB.PHASE.VERIFY phase_revisit_candidates_common2_tol_0_20
OP HB.AGE.CONDITION CONDITION HB.REVISIT.TRANSFORM prior_frame_age_le_64
OP HB.BASELINE.COMPOSE COMPOSITION HB.PREVIOUS.SOURCE HB.AGE.CONDITION
OP HB.XORCOST.TRANSFORM TRANSFORM HB.BASELINE.COMPOSE exact_changed_u64_word_count
OP HB.SELECT.TRANSFORM TRANSFORM HB.XORCOST.TRANSFORM lexicographic_cost_age_frame_selector
OP HB.NOWORSE.CONDITION CONDITION HB.SELECT.TRANSFORM selected_cost_le_previous_frame_cost
OP HB.ROUTE.TRANSFORM TRANSFORM HB.NOWORSE.CONDITION run_ref_or_delta_xor64
OP HB.DECODE.TRANSFORM TRANSFORM HB.ROUTE.TRANSFORM paux.lossless_decode
OP HB.EXACT.CONDITION CONDITION HB.DECODE.TRANSFORM pnv_state_object_exact_verify
OP HB.EVIDENCE.COMPOSE COMPOSITION HB.EXACT.CONDITION paux.harmonic_base_lossless_receipt
OP HB.RETURN RETURN HB.EVIDENCE.COMPOSE

ASSERT HB.PHASE.VERIFY
ASSERT HB.AGE.CONDITION
ASSERT HB.NOWORSE.CONDITION
ASSERT HB.EXACT.CONDITION
EMIT HB.RETURN

# PROFILE PAUX-C
# CANDIDATE_COMMON_H_BANDS_MIN 2
# CANDIDATE_PHASE_DISTANCE_MAX_RAD 0.20
# CANDIDATE_MAX_AGE_FRAMES 64
# BASELINE_PREVIOUS_FRAME_ALWAYS_INCLUDED TRUE
# SELECTION_COST CHANGED_U64_WORDS AGE FRAME_INDEX
# FLOATING_PREDICTOR FALSE
# DELTA_TRANSFORM EXACT_UINT64_XOR
# EXACT_DECODE_REQUIRED TRUE
# OBJECT_ID_AUTHORITY PNV_STATE_OBJECT
# CAPABILITY_AUTHORITY PNCAP
# EFFECT_AUTHORITY AUX
# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
