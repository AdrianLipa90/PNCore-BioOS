PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# Cross-repository persistence spine:
# PNV-State-Memory -> PAUX-EXACT -> DNCrypt -> PNStore -> recovery.

OP PSM.LIVE.AUX SOURCE noema.aux_phi.float64_le_36
OP PSM.STATE.IDENTITY SOURCE pnv_state_memory.checkpoint_identity
OP PSM.STATE.BINDING SOURCE pnv_state_memory.aux_binding_receipt
OP PSM.PAUX TRANSFORM PSM.LIVE.AUX pnv_state_memory.paux_exact.bind_phase_checkpoint
OP PSM.PAUX.IDENTITY CONDITION PSM.PAUX PSM.STATE.IDENTITY

OP PSM.AAD TRANSFORM PSM.PAUX pnv_state_memory.paux_exact.authenticated_reconstruction_descriptor
OP PSM.CRYPTO.AUTHORITY SOURCE pncap.persistence_transport.grant
OP PSM.ENCRYPT.ORDER ORDER PSM.CRYPTO.AUTHORITY PSM.PAUX.IDENTITY PSM.AAD
OP PSM.ENCRYPT TRANSFORM PSM.ENCRYPT.ORDER dncrypt.encrypt
OP PSM.BINARY TRANSFORM PSM.ENCRYPT dncrypt.pack_envelope
OP PSM.BINARY.FIT CONDITION PSM.BINARY pnstore.extent_payload_max_3936

OP PSM.STORE.ORDER ORDER PSM.BINARY.FIT PSM.STATE.IDENTITY
OP PSM.PREPARE TRANSFORM PSM.STORE.ORDER pnstore.prepare_commit
OP PSM.DURABLE.EXTENT CONDITION PSM.PREPARE pnstore.durable_barrier
OP PSM.HEAD TRANSFORM PSM.DURABLE.EXTENT pnstore.publish_head
OP PSM.DURABLE.HEAD CONDITION PSM.HEAD pnstore.durable_barrier
OP PSM.STORE.RETURN RETURN PSM.DURABLE.HEAD

OP PSM.RECOVER SOURCE pnstore.current_generation_payload
OP PSM.UNPACK TRANSFORM PSM.RECOVER dncrypt.unpack_envelope
OP PSM.RECEIPT CONDITION PSM.UNPACK dncrypt.provenance_receipt_valid
OP PSM.AAD.MATCH CONDITION PSM.UNPACK bioos.expected_authenticated_aad_exact
OP PSM.DECRYPT.ORDER ORDER PSM.RECEIPT PSM.AAD.MATCH
OP PSM.DECRYPT TRANSFORM PSM.DECRYPT.ORDER dncrypt.decrypt
OP PSM.PAUX.EXACT CONDITION PSM.DECRYPT pnv_state_memory.paux_exact.payload_sha_exact
OP PSM.RECONSTRUCT TRANSFORM PSM.PAUX.EXACT pnv_state_memory.paux_exact.reconstruct_phase_checkpoint
OP PSM.OBJECT.MATCH CONDITION PSM.RECONSTRUCT PSM.STATE.IDENTITY
OP PSM.LINEAGE.MATCH CONDITION PSM.RECONSTRUCT PSM.STATE.BINDING
OP PSM.RECOVER.COMPOSE COMPOSITION PSM.OBJECT.MATCH PSM.LINEAGE.MATCH
OP PSM.RECOVER.RETURN RETURN PSM.RECOVER.COMPOSE

ASSERT PSM.PAUX.IDENTITY
ASSERT PSM.CRYPTO.AUTHORITY
ASSERT PSM.BINARY.FIT
ASSERT PSM.DURABLE.EXTENT
ASSERT PSM.DURABLE.HEAD
ASSERT PSM.RECEIPT
ASSERT PSM.AAD.MATCH
ASSERT PSM.PAUX.EXACT
ASSERT PSM.OBJECT.MATCH
ASSERT PSM.LINEAGE.MATCH
EMIT PSM.STORE.RETURN
EMIT PSM.RECOVER.RETURN

# PNV_CANONICAL_OBJECT_ID_PRESERVED TRUE
# PAUX_EXACT_BYTES 288
# PNSTORE_PAYLOAD_MAX 3936
# DNCrypt_BINARY_IS_REPRESENTATION_ID TRUE
# STATE_MEMORY_OWNS_RECONSTRUCTION TRUE
# PNSTORE_OWNS_DURABILITY_ORDER TRUE
# STATIC_RUNTIME_FALLBACK FALSE
# NEW_PNV_OPCODES 0
# CANON_ALLOWED FALSE
