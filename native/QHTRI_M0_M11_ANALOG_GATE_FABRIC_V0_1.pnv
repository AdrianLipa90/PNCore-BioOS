PNV.PROGRAM QHTRI_M0_M11_ANALOG_GATE_FABRIC_V0_1
PNV.VERSION 0.1
PNV.STATUS CANDIDATE
PNV.EPISTEMIC CHYBA
PNV.CANON_ALLOWED false

REQUIRE T36_PHASE_FIELD
REQUIRE NEXUS_HYPERCRYSTAL
REQUIRE M0_M11_SEMANTIC_BINDING
REQUIRE QHTRI_TORSION_FLOW
REQUIRE TORSION_INTEGRATOR_BUDGET

INVARIANT DIMENSION 36
INVARIANT WHOLE_SEMANTIC_LANES true
INVARIANT COORDINATE_POSITION_MAPPING false
INVARIANT KAPPA ln(2)/(24*pi)
INVARIANT M8_PROTECTED true
INVARIANT M10_APPEND_ONLY true
INVARIANT AUTHORITY_GRANT false
INVARIANT EXECUTION_ADMITTED false
INVARIANT STATIC_FALLBACK false

OP LOCK_FIELD
  INPUT theta[36] target[36] gain[36] tau
  POTENTIAL -SUM_j gain[j]*COS(theta[j]-target[j]-tau)
  FORCE_j -gain[j]*SIN(theta[j]-target[j]-tau)
END

OP TORSION_FIELD
  INPUT theta[36] edge(i,j,m,n,tau,K,R)
  EPSILON WRAP(n*theta[i]-m*theta[j]-tau)
  GAIN K*R
  FORCE_i -n*GAIN*SIN(EPSILON)
  FORCE_j +m*GAIN*SIN(EPSILON)
END

OP ANALOG_AND INPUT a b OUTPUT CLAMP01(a)*CLAMP01(b)
OP ANALOG_OR  INPUT a b OUTPUT CLAMP01(a)+CLAMP01(b)-CLAMP01(a)*CLAMP01(b)
OP ANALOG_NOT INPUT a   OUTPUT 1-CLAMP01(a)
OP ANALOG_XOR INPUT a b OUTPUT CLAMP01(a)+CLAMP01(b)-2*CLAMP01(a)*CLAMP01(b)

LAYER M0 OBSERVE
  SOURCE provenance_required
  FIELD LOCK_FIELD
  MISSING_SOURCE QUIET
END

LAYER M1 ACTIVE_WORKING_SET
  FIELD LOCK_FIELD
  GAIN KAPPA*ANALOG_AND(command_activation,context_admission)
END

LAYER M2 EPISODIC_TRANSITION
  FIELD LOCK_FIELD
  REQUIRE transition_explicit
  DURABLE_AFTER validation
END

LAYER M3 SEMANTIC_ATTRACTOR
  FIELD CIRCULAR_BARYCENTER_LOCK
  SOURCE admitted_semantic_candidates
END

LAYER M4 PROCEDURE_VALIDATOR
  ADMISSION ANALOG_AND(ANALOG_AND(procedure_match,validator_confidence),capability_admission)
  MISSING_ADMISSION CANDIDATE_GAIN_ZERO
END

LAYER M5 EXPLICIT_AFFECT
  MODE SALIENCE_MODULATOR
  IMPLICIT_INPUT NEUTRAL_MULTIPLIER_1
  TRUTH_EFFECT false
  AUTHORITY_EFFECT false
  EXECUTION_EFFECT false
END

LAYER M6 RELATIONAL_TORSION
  FIELD TORSION_FIELD
  EDGE_SEMANTICS rational_m_to_n
END

LAYER M7 DELIBERATION_BRAID
  FIELD CIRCULAR_BARYCENTER_LOCK
  DISAGREEMENT weakens_gain
  FORCED_SELECTION false
END

LAYER M8 PROTECTED_IDENTITY
  FIELD LOCK_FIELD
  MODE RESTORING_REFERENCE
  REFERENCE_MUTATION DENY
END

LAYER M9 HOLONOMY
  FIELD LOCK_FIELD
  TARGET transport(previous_target,holonomy[36])
END

LAYER M10 RECEIPT_PROVENANCE
  FORCE ZERO
  MODE APPEND_ONLY_OBSERVER
  OVERWRITE DENY
END

LAYER M11 EPISTEMIC_CLOSURE
  CLOSURE validation_confidence*(1-uncertainty)*(1-no_go)
  NO_GO_1 EFFECT_GAIN_ZERO
  PRESERVE M8 M10
END

COMPOSE
  V_TOTAL SUM admitted_layer_potentials
  DTHETA_DT omega - GRAD(V_TOTAL) + F_M8
  L_TOTAL L_anchor + L_torsion
  DT_SAFE MIN(dt_requested,0.2/L_TOTAL) WHEN L_TOTAL>0
END

OUTPUT theta_after[36]
OUTPUT layer_status[M0..M11]
OUTPUT receipt_candidate_M10
OUTPUT authority_grant=false
OUTPUT execution_admitted=false
