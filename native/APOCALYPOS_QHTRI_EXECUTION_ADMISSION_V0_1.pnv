SCHEMA APOCALYPOS_QHTRI_EXECUTION_ADMISSION_V0_1
STATUS ARCHITECTURE_CANDIDATE
EPISTEMIC CHYBA

NATIVE_RUNTIME QHTRI_NOEMA_APOCALYPOS_VECTOR
REALIZATION_BOUNDARY X86_64_QEMU_BINARY_ADAPTER

READS_FROM NOEMA_QHTRI_SEMANTIC_LOOP_CANDIDATE
READS_FROM NOEMA_QHTRI_FEEDBACK_CANDIDATE
READS_FROM BIOOS_VECTOR_NATIVE_QHTRI_SOURCE_V0_1
READS_FROM BIOOS_VECTOR_NATIVE_QHTRI_REPLAY_V0_1
READS_FROM BIOOS_VECTOR_NATIVE_QHTRI_QEMU_BUILD_V0_1
READS_FROM APOCALYPOS_PNCAP_SHADOW_GRANT_V0_1

ADMISSION_REQUIRE CAPABILITY EXECUTE_PROGRAM
ADMISSION_REQUIRE TARGET_REF QEMU_QHTRI_VECTOR_REPLAY
ADMISSION_REQUIRE OPERATION_REF SHADOW_QEMU
ADMISSION_REQUIRE GENERATION_EXACT
ADMISSION_REQUIRE SOURCE_REPLAY_BUILD_LINEAGE_EXACT
ADMISSION_REQUIRE SEMANTIC_FEEDBACK_PARENT_EXACT

MAY_CONTROL SHADOW_QEMU_REALIZATION_ADAPTER
MUST_NOT_CONTROL PHYSICAL_QPU
MUST_NOT_CONTROL PHYSICAL_H200
MUST_NOT_CONTROL PRODUCTION_RUNTIME
MUST_NOT_CONTROL CANON

PRODUCES_RECEIPT APOCALYPOS_QHTRI_EXECUTION_ADMISSION_V0_1
PRODUCES_RECEIPT APOCALYPOS_QHTRI_EXECUTION_RESULT_V0_1
PRODUCES_RECEIPT NOEMA_QHTRI_REINTEGRATION_CANDIDATE_V0_1

FAIL_CLOSED MISSING_SEAL
FAIL_CLOSED LINEAGE_MISMATCH
FAIL_CLOSED GENERATION_MISMATCH
FAIL_CLOSED CAPABILITY_MISMATCH
FAIL_CLOSED TARGET_MISMATCH
FAIL_CLOSED OPERATION_MISMATCH
FAIL_CLOSED AUTHORITY_ESCALATION
FAIL_CLOSED QEMU_CONFORMANCE_FAILURE

SHADOW_EXECUTION_ADMITTED MAY_BECOME_TRUE
PRODUCTION_EXECUTION_ADMITTED false
PHYSICAL_EFFECT_AUTHORITY false
PRODUCTION_RUNTIME_WRITE false
CANON_ALLOWED false
PHYSICAL_QPU_CLAIM false
PHYSICAL_H200_EXECUTION_CLAIM false
