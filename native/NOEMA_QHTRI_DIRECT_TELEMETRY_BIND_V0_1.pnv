PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP QHTRI.PHI.SOURCE SOURCE noema.qhtri.phi
OP QHTRI.PHI.IDENTITY IDENTITY QHTRI.PHI.SOURCE
OP QHTRI.OMEGA.SOURCE SOURCE noema.qhtri.omega
OP QHTRI.OMEGA.IDENTITY IDENTITY QHTRI.OMEGA.SOURCE
OP QHTRI.TICK.SOURCE SOURCE noema.qhtri.tick
OP QHTRI.TICK.ORDER ORDER QHTRI.TICK.SOURCE qhtri_tick_window
OP QHTRI.PROVENANCE.SOURCE SOURCE noema.qhtri.surface_provenance
OP QHTRI.SOURCE.COMPOSE COMPOSITION QHTRI.PHI.IDENTITY QHTRI.OMEGA.IDENTITY
OP QHTRI.WINDOW.COMPOSE COMPOSITION QHTRI.SOURCE.COMPOSE QHTRI.TICK.ORDER
OP QHTRI.DIRECT.CONDITION CONDITION QHTRI.WINDOW.COMPOSE direct_phase_direct_omega_admitted
OP QHTRI.READONLY.CONDITION CONDITION QHTRI.DIRECT.CONDITION qhtri_source_read_only
OP QHTRI.EVIDENCE.COMPOSE COMPOSITION QHTRI.READONLY.CONDITION QHTRI.PROVENANCE.SOURCE
OP QHTRI.RETURN RETURN QHTRI.EVIDENCE.COMPOSE

ASSERT QHTRI.PHI.IDENTITY
ASSERT QHTRI.OMEGA.IDENTITY
ASSERT QHTRI.DIRECT.CONDITION
ASSERT QHTRI.READONLY.CONDITION
EMIT QHTRI.RETURN

# SOURCE_CLASS NATURAL_SYSTEM_STATE
# DYNAMICS_CLASS ENDOGENOUS_RUNTIME_DYNAMICS
# EXISTING_TAU36_BIND_AS_EDGE_TORSION DENIED
# NEW_PNV_OPCODES 0
