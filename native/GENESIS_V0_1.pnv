PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# First BioOS native system program candidate.
# Triple Pulse admission is required before this program is entered.

OP GEN.ENV.SOURCE SOURCE boot.environment
OP GEN.ENV.VERIFY IDENTITY GEN.ENV.SOURCE
OP GEN.STORE.SOURCE SOURCE pnstore.current_generation
OP GEN.STORE.VERIFY IDENTITY GEN.STORE.SOURCE
OP GEN.ORDER ORDER GEN.ENV.VERIFY GEN.STORE.VERIFY

OP GEN.ROOT.TRANSFORM TRANSFORM GEN.ORDER pnobject.system_root_candidate
OP GEN.VIEW.TRANSFORM TRANSFORM GEN.ROOT.TRANSFORM pnfs.root_view_candidate
OP GEN.COMPOSE COMPOSITION GEN.ROOT.TRANSFORM GEN.VIEW.TRANSFORM
OP GEN.ADMIT.CONDITION CONDITION GEN.COMPOSE genesis_state_admitted
OP GEN.SIGMA.TRANSFORM TRANSFORM GEN.ADMIT.CONDITION bioos.sigma_0
OP GEN.RETURN RETURN GEN.SIGMA.TRANSFORM

ASSERT GEN.ENV.VERIFY
ASSERT GEN.STORE.VERIFY
ASSERT GEN.ADMIT.CONDITION
EMIT GEN.RETURN

# PRODUCES Sigma_0
# EXTERNAL_EFFECTS FALSE
# NEW_PNV_OPCODES 0
