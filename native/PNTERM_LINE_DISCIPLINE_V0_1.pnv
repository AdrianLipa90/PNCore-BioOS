PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNTERM L1: deterministic UTF-8 line discipline.

OP LINE.CHUNK.SOURCE SOURCE pnterm.rx_utf8_chunk
OP LINE.UTF8.CONDITION CONDITION LINE.CHUNK.SOURCE incremental_utf8_valid
OP LINE.CONTROL.TRANSFORM TRANSFORM LINE.UTF8.CONDITION cr_lf_crlf_bs_del_tab_rules
OP LINE.BOUNDS.CONDITION CONDITION LINE.CONTROL.TRANSFORM line_bytes_le_1024_and_codepoints_le_512
OP LINE.EMPTY.CONDITION CONDITION LINE.BOUNDS.CONDITION empty_line_is_noop
OP LINE.HASH.TRANSFORM TRANSFORM LINE.BOUNDS.CONDITION sha256_canonical_line_without_terminator
OP LINE.EVIDENCE.COMPOSE COMPOSITION LINE.HASH.TRANSFORM pnterm.line_evidence
OP LINE.RETURN RETURN LINE.EVIDENCE.COMPOSE

ASSERT LINE.UTF8.CONDITION
ASSERT LINE.BOUNDS.CONDITION
EMIT LINE.RETURN

# NUL_ESC_OTHER_C0_C1 REJECT
# ANSI_ESCAPE_PARSER RESERVED_QUIET
# NEW_PNV_OPCODES 0
