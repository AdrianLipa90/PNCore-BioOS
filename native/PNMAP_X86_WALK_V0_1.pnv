PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP PMW.ANCHOR SOURCE map.cr3_anchor
OP PMW.ANCHOR.IDENTITY IDENTITY PMW.ANCHOR
OP PMW.CONTEXT SOURCE map.generation_context
OP PMW.CONTEXT.IDENTITY IDENTITY PMW.CONTEXT
OP PMW.AUTH SOURCE map.capability_authority
OP PMW.AUTH.IDENTITY IDENTITY PMW.AUTH
OP PMW.SELECTOR SOURCE map.virtual_selector
OP PMW.ORDER ORDER PMW.ANCHOR.IDENTITY PMW.CONTEXT.IDENTITY
OP PMW.COUPLE COMPOSITION PMW.ORDER PMW.AUTH.IDENTITY
OP PMW.RESOLVE TRANSFORM PMW.COUPLE page_walk_target
OP PMW.ADMIT CONDITION PMW.RESOLVE exact_page_walk_admitted
OP PMW.EVIDENCE COMPOSITION PMW.ADMIT map.walk_evidence
OP PMW.RETURN RETURN PMW.EVIDENCE

ASSERT PMW.ANCHOR.IDENTITY
ASSERT PMW.AUTH.IDENTITY
ASSERT PMW.ADMIT
EMIT PMW.RETURN

# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
# STATIC_RUNTIME_FALLBACK FALSE
