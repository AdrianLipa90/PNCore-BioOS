PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PAUX v0.2.6 stage-3 derived harmonic resonance graph.

OP HR.FITS.SOURCE SOURCE paux.stage2_rational_fit_history
OP HR.FITS.VERIFY CONDITION HR.FITS.SOURCE resolved_finite_fit_score_ge_0_85
OP HR.WINDOWS.TRANSFORM TRANSFORM HR.FITS.VERIFY shared_window_intersection
OP HR.WINDOWS.CONDITION CONDITION HR.WINDOWS.TRANSFORM shared_windows_min4
OP HR.LINEAGE.CONDITION CONDITION HR.WINDOWS.CONDITION lineage_series_ref_equal
OP HR.RATIO.TRANSFORM TRANSFORM HR.LINEAGE.CONDITION exact_pair_ratio_reduce
OP HR.ORDER.CONDITION CONDITION HR.RATIO.TRANSFORM max_pair_order_16
OP HR.PHASE.TRANSFORM TRANSFORM HR.ORDER.CONDITION phase_invariant_n_theta_i_minus_m_theta_j
OP HR.WEIGHT.TRANSFORM TRANSFORM HR.PHASE.TRANSFORM sqrt_stage2_fit_score_product
OP HR.COHERENCE.TRANSFORM TRANSFORM HR.WEIGHT.TRANSFORM weighted_circular_resultant
OP HR.LOCK.CONDITION CONDITION HR.COHERENCE.TRANSFORM phase_lock_R_ge_0_90
OP HR.EDGE.TRANSFORM TRANSFORM HR.LOCK.CONDITION canonical_hband_resonance_edge
OP HR.AUTHORITY.CONDITION CONDITION HR.EDGE.TRANSFORM derived_index_only
OP HR.GRAPH.COMPOSE COMPOSITION HR.AUTHORITY.CONDITION paux.harmonic_resonance_graph
OP HR.EVIDENCE.COMPOSE COMPOSITION HR.GRAPH.COMPOSE paux.resonance_graph_receipt
OP HR.RETURN RETURN HR.EVIDENCE.COMPOSE

ASSERT HR.FITS.VERIFY
ASSERT HR.WINDOWS.CONDITION
ASSERT HR.LINEAGE.CONDITION
ASSERT HR.ORDER.CONDITION
ASSERT HR.LOCK.CONDITION
ASSERT HR.AUTHORITY.CONDITION
EMIT HR.RETURN

# MIN_SHARED_WINDOWS 4
# MIN_STAGE2_FIT_SCORE 0.85
# MIN_PHASE_LOCK_R 0.90
# MAX_RESONANCE_ORDER 16
# PHASE_INVARIANT n*theta_i-m*theta_j_FOR_fi_over_fj_eq_m_over_n
# EDGE_ORIENTATION CANONICAL_H_INDEX_ORDER
# EDGE_REVERSE_RATIO n:m
# EDGE_REVERSE_R SAME
# EDGE_REVERSE_DELTA NEGATED
# GRAPH_CLASS HARMONIC_RESONANCE_DERIVED_INDEX
# OBJECT_ID_AUTHORITY PNV_STATE_OBJECT
# CAPABILITY_AUTHORITY PNCAP
# EFFECT_AUTHORITY AUX
# NEW_PNV_OPCODES 0
# FAIL_CLOSED TRUE
