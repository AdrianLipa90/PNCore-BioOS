PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# Bounded pre-integration admission for QHTRI torsion graphs.
# This program computes/admits budget evidence only.

OP TIB.GRAPH.SOURCE SOURCE noema.torsion_memory.current_generation
OP TIB.GRAPH.VERIFY IDENTITY TIB.GRAPH.SOURCE
OP TIB.POLICY.SOURCE SOURCE torsion.integrator_budget.policy_v0_1
OP TIB.POLICY.VERIFY IDENTITY TIB.POLICY.SOURCE
OP TIB.EPOCH.CONDITION CONDITION TIB.GRAPH.VERIFY memory_epoch_current

OP TIB.LOAD.TRANSFORM TRANSFORM TIB.GRAPH.VERIFY torsion.lipschitz_load
OP TIB.SUBSTEPS.TRANSFORM TRANSFORM TIB.LOAD.TRANSFORM torsion.required_substeps
OP TIB.ORDER ORDER TIB.POLICY.VERIFY TIB.EPOCH.CONDITION TIB.SUBSTEPS.TRANSFORM
OP TIB.ADMIT.CONDITION CONDITION TIB.ORDER substep_budget_not_exceeded
OP TIB.COMPOSE COMPOSITION TIB.ORDER TIB.ADMIT.CONDITION
OP TIB.RETURN RETURN TIB.COMPOSE

ASSERT TIB.GRAPH.VERIFY
ASSERT TIB.POLICY.VERIFY
ASSERT TIB.EPOCH.CONDITION
ASSERT TIB.ADMIT.CONDITION
EMIT TIB.RETURN

# T_EXEC_REFERENCE_RATIONAL 100/783
# N_SUB_FORMULA ceil(T_exec*L_bound/0.2)
# BUDGET_EXCEEDED_EFFECT INTEGRATION_INACTIVE
# EDGE_REWRITE FALSE
# CAPABILITY_GRANT FALSE
# EXTERNAL_EFFECTS FALSE
# NEW_PNV_OPCODES 0
# CANON_ALLOWED FALSE
