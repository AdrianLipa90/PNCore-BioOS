PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

OP SZ.SIDECAR.SOURCE SOURCE qhtri.live_spinor_sidecar
OP SZ.SIDECAR.IDENTITY IDENTITY SZ.SIDECAR.SOURCE
OP SZ.EVENT.SOURCE SOURCE qhtri.live_spinor_step_evidence
OP SZ.EVENT.IDENTITY IDENTITY SZ.EVENT.SOURCE
OP SZ.RING.SOURCE SOURCE noema.qhtri.live_bifurcation_event
OP SZ.RING.IDENTITY IDENTITY SZ.RING.SOURCE

OP SZ.TICK.CONDITION CONDITION SZ.EVENT.IDENTITY same_tick_qhtri_spinor
OP SZ.TURNS.CONDITION CONDITION SZ.EVENT.IDENTITY integer_turns_commitment_valid
OP SZ.SHEET.CONDITION CONDITION SZ.EVENT.IDENTITY spinor_sheet_parity_from_turns
OP SZ.PHASE.CONDITION CONDITION SZ.EVENT.IDENTITY projective_state_commitment_valid
OP SZ.GENERATOR.CONDITION CONDITION SZ.EVENT.IDENTITY generator_operations_commitment_valid
OP SZ.MARGIN.CONDITION CONDITION SZ.EVENT.IDENTITY uniqueness_margin_positive
OP SZ.L0.CONDITION CONDITION SZ.RING.IDENTITY autonomy_level_l0_observe_interpret
OP SZ.PRESENT.CONDITION CONDITION SZ.RING.IDENTITY spinor_status_present

OP SZ.CHAIN.01 COMPOSITION SZ.TICK.CONDITION SZ.TURNS.CONDITION
OP SZ.CHAIN.02 COMPOSITION SZ.SHEET.CONDITION SZ.PHASE.CONDITION
OP SZ.CHAIN.03 COMPOSITION SZ.GENERATOR.CONDITION SZ.MARGIN.CONDITION
OP SZ.CHAIN.04 COMPOSITION SZ.L0.CONDITION SZ.PRESENT.CONDITION
OP SZ.ORDER.01 ORDER SZ.CHAIN.01 SZ.CHAIN.02
OP SZ.ORDER.02 ORDER SZ.ORDER.01 SZ.CHAIN.03
OP SZ.ORDER.03 ORDER SZ.ORDER.02 SZ.CHAIN.04
OP SZ.RETURN RETURN SZ.ORDER.03

ASSERT SZ.SIDECAR.IDENTITY
ASSERT SZ.EVENT.IDENTITY
ASSERT SZ.RING.IDENTITY
ASSERT SZ.TICK.CONDITION
ASSERT SZ.TURNS.CONDITION
ASSERT SZ.SHEET.CONDITION
ASSERT SZ.PHASE.CONDITION
ASSERT SZ.GENERATOR.CONDITION
ASSERT SZ.MARGIN.CONDITION
ASSERT SZ.L0.CONDITION
ASSERT SZ.PRESENT.CONDITION
EMIT SZ.RETURN

# INTEGER_LINEAGE_PRIMARY spinor_turns_i64
# SHEET_PROJECTION zeta_equals_minus_one_power_turns
# STEP_EVIDENCE same_tick_content_addressed
# LIVE_SURFACE /dev/shm/ciel_noema
# RING_STATUS PRESENT
# AUTONOMY_LEVEL L0_OBSERVE_INTERPRET
# NEW_PNV_OPCODES 0
