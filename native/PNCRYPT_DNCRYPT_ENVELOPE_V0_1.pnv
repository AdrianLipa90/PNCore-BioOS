PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# BioOS <-> DNCrypt native encryption-boundary candidate.
# Uses existing PNCS operators only. No new PNV opcode.
# DNCrypt source pin: repo AdrianLipa90/DNCrypt
# commit 20f53a9b297b6208d74841aee7c3bb4b8b17ce2a
# native program blob 99df240db1db020dea24b51b160de90bce727eb2

OP PNC.IDENTITY SOURCE pnv_state_object.object_id
OP PNC.GENERATION SOURCE pnv_state_object.generation
OP PNC.PAUX.PROFILE SOURCE paux.profile
OP PNC.PLAINTEXT SOURCE paux.exact_or_encoded_payload
OP PNC.EXEC.GRANT SOURCE pncap.execute_program.grant
OP PNC.EXEC.RECEIPT SOURCE pncap.execute_program.receipt
OP PNC.PARENT.RECEIPT SOURCE parent.persistence_or_evolution_receipt
OP PNC.CONTEXT SOURCE destination.domain.context
OP PNC.KEY.HANDLE SOURCE dncrypt.master_key_handle
OP PNC.DNCRYPT.PROGRAM.IDENTITY IDENTITY dncrypt.native.pncs.v0.3

OP PNC.AUTHORITY CONDITION PNC.EXEC.GRANT PNC.DNCRYPT.PROGRAM.IDENTITY
OP PNC.AAD COMPOSITION PNC.IDENTITY PNC.GENERATION PNC.PAUX.PROFILE PNC.EXEC.RECEIPT PNC.PARENT.RECEIPT PNC.CONTEXT
OP PNC.ENCRYPT.ORDER ORDER PNC.AUTHORITY PNC.AAD
OP PNC.ENCRYPT TRANSFORM PNC.PLAINTEXT dncrypt.native.pncs.v0.3.encrypt
OP PNC.ENVELOPE COMPOSITION PNC.IDENTITY PNC.AAD PNC.ENCRYPT
OP PNC.ENVELOPE.IDENTITY TRANSFORM PNC.ENVELOPE content_addressed_envelope_id
OP PNC.ENCRYPT.RETURN RETURN PNC.ENVELOPE.IDENTITY

OP PNC.CIPHERTEXT SOURCE dncrypt.envelope.bytes
OP PNC.ENVELOPE.RECEIPT SOURCE dncrypt.message.receipt
OP PNC.VERIFY CONDITION PNC.CIPHERTEXT PNC.ENVELOPE.RECEIPT PNC.AAD
OP PNC.DECRYPT.ORDER ORDER PNC.AUTHORITY PNC.VERIFY
OP PNC.DECRYPT TRANSFORM PNC.CIPHERTEXT dncrypt.native.pncs.v0.3.decrypt
OP PNC.PAUX.VERIFY CONDITION PNC.DECRYPT paux.identity_integrity_valid
OP PNC.PNV.VERIFY CONDITION PNC.PAUX.VERIFY PNC.IDENTITY
OP PNC.DECRYPT.RETURN RETURN PNC.PNV.VERIFY

ASSERT PNC.DNCRYPT.PROGRAM.IDENTITY
ASSERT PNC.AUTHORITY
ASSERT PNC.AAD
ASSERT PNC.ENVELOPE.IDENTITY
ASSERT PNC.VERIFY
ASSERT PNC.PAUX.VERIFY
ASSERT PNC.PNV.VERIFY

EMIT PNC.ENCRYPT.RETURN
EMIT PNC.DECRYPT.RETURN

# CANONICAL_OBJECT_ID_MUTATION FALSE
# ENVELOPE_ID_DISTINCT_FROM_OBJECT_ID TRUE
# MASTER_KEY_PLAINTEXT_PERSISTENCE FALSE
# LOCAL_DEV_SHM_ENCRYPTION_REQUIRED FALSE
# PNCAP_NEW_OPERATION_REQUIRED FALSE
# STATIC_RUNTIME_FALLBACK FALSE
# NEW_PNV_OPCODES 0
# CANON_ALLOWED FALSE
