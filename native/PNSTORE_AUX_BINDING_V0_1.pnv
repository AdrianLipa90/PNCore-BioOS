PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNStore persistence effect binding through AUX.

OP STORE.AUX.OBJECT.SOURCE SOURCE paux.object
OP STORE.AUX.OBJECT.VERIFY IDENTITY STORE.AUX.OBJECT.SOURCE
OP STORE.AUX.CAP.SOURCE SOURCE pncap.persistence_grant
OP STORE.AUX.CAP.VERIFY IDENTITY STORE.AUX.CAP.SOURCE
OP STORE.AUX.REQUEST.ORDER ORDER STORE.AUX.CAP.VERIFY STORE.AUX.OBJECT.VERIFY
OP STORE.AUX.PREPARE.TRANSFORM TRANSFORM STORE.AUX.REQUEST.ORDER aux.persist.append_prepared_generation
OP STORE.AUX.BARRIER1.ORDER ORDER STORE.AUX.PREPARE.TRANSFORM aux.persist.durable_barrier
OP STORE.AUX.HEAD.TRANSFORM TRANSFORM STORE.AUX.BARRIER1.ORDER aux.persist.publish_head
OP STORE.AUX.BARRIER2.ORDER ORDER STORE.AUX.HEAD.TRANSFORM aux.persist.durable_barrier
OP STORE.AUX.EVIDENCE.COMPOSE COMPOSITION STORE.AUX.BARRIER2.ORDER pnstore.commit_evidence
OP STORE.AUX.RETURN RETURN STORE.AUX.EVIDENCE.COMPOSE

ASSERT STORE.AUX.OBJECT.VERIFY
ASSERT STORE.AUX.CAP.VERIFY
ASSERT STORE.AUX.EVIDENCE.COMPOSE
EMIT STORE.AUX.RETURN

# PERSISTENT_EXTENSION .paux
# DEVICE_ADAPTER_AUTHORITY AUX
# EXACT_CAPABILITY_REQUIRED TRUE
# DURABLE_BARRIER_COUNT 2
# EXACTLY_ONCE_TRANSITION_ID REQUIRED
# NEW_PNV_OPCODES 0
