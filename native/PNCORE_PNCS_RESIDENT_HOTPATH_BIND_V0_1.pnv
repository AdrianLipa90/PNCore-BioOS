MODE INTERNAL_EXECUTION

# BioOS <-> PNCS v0.30 resident-hotpath binding candidate.
# PNCS source pin: feat/pncs-v0.30-resident-hotpath @ 5e132141c503081f53791b73d9c9e24263891f4f

OP PNH.LIVE.SURFACE SOURCE /dev/shm/ciel_noema
OP PNH.PNCAP.GRANT SOURCE pncap.execute_program.grant
OP PNH.PNCS.CONTRACT SOURCE pncs.resident_hotpath.v0.30
OP PNH.RESIDENT.HANDLE SOURCE pncs.resident.handle
OP PNH.FULL.ADMISSION SOURCE pncs.v0.25.resident_admission
OP PNH.HOT.TOKEN SOURCE pncs.v0.30.hot_token
OP PNH.GENERATION SOURCE noema.live.generation
OP PNH.AUTHORITY CONDITION PNH.PNCAP.GRANT PNH.PNCS.CONTRACT
OP PNH.ADMISSION CONDITION PNH.FULL.ADMISSION PNH.RESIDENT.HANDLE
OP PNH.TOKEN.BIND CONDITION PNH.HOT.TOKEN PNH.GENERATION
OP PNH.ORDER ORDER PNH.AUTHORITY PNH.ADMISSION PNH.TOKEN.BIND
OP PNH.DISPATCH TRANSFORM PNH.ORDER pncs.v0.30.dispatch_control
OP PNH.RECEIPT CONDITION PNH.DISPATCH exact_v20_v22_lineage_and_receipt
OP PNH.RETURN RETURN PNH.RECEIPT

ASSERT PNH.AUTHORITY
ASSERT PNH.ADMISSION
ASSERT PNH.TOKEN.BIND
ASSERT PNH.RECEIPT
EMIT PNH.RETURN

