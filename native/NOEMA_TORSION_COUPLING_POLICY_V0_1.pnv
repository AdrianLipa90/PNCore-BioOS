PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

OP CP.GRAPH.SOURCE SOURCE noema.torsion_memory_canonical_graph
OP CP.GRAPH.VERIFY IDENTITY CP.GRAPH.SOURCE
OP CP.KAPPA.SOURCE SOURCE phasenav.kappa_constant
OP CP.KAPPA.VERIFY IDENTITY CP.KAPPA.SOURCE
OP CP.DEGREE.TRANSFORM TRANSFORM CP.GRAPH.VERIFY canonical_node_degree
OP CP.DENOM.TRANSFORM TRANSFORM CP.DEGREE.TRANSFORM max_endpoint_degree_floor_one
OP CP.K.TRANSFORM TRANSFORM CP.DENOM.TRANSFORM kappa_over_degree_max
OP CP.R.SOURCE SOURCE paux.resonance_edge_weight
OP CP.LOAD.COMPOSE COMPOSITION CP.K.TRANSFORM CP.R.SOURCE
OP CP.LOAD.CONDITION CONDITION CP.LOAD.COMPOSE per_node_raw_load_le_kappa
OP CP.POLICY.COMPOSE COMPOSITION CP.LOAD.CONDITION CP.KAPPA.VERIFY
OP CP.EVIDENCE.COMPOSE COMPOSITION CP.POLICY.COMPOSE noema.torsion_coupling_policy_evidence
OP CP.RETURN RETURN CP.EVIDENCE.COMPOSE

ASSERT CP.GRAPH.VERIFY
ASSERT CP.KAPPA.VERIFY
ASSERT CP.LOAD.CONDITION
EMIT CP.RETURN

# POLICY_ID DEGREE_MAX_KAPPA_V0_1
# KAPPA ln2_over_24pi
# FORMULA K_ij=kappa/max(1,degree_i,degree_j)
# SYMMETRIC TRUE
# RECOMPILE_ON_TOPOLOGY_CHANGE TRUE
# RAW_NODE_LOAD_BOUND KAPPA
# NEW_PNV_OPCODES 0
